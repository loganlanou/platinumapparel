package pages

import (
	"platinumapparel/internal/meta"
	"platinumapparel/templates/layouts"
)

templ Collections() {
	@layouts.Base(meta.New("Collections", "Explore our curated collections of luxury menswear, fine jewelry, and prestigious timepieces.")) {
		// Hero
		<section class="page-hero">
			<div class="page-hero-content" data-animate="fade-up">
				<span class="page-label">Curated Excellence</span>
				<h1 class="page-title">Our Collections</h1>
				<p class="page-subtitle">Each collection represents a distinct expression of luxury, crafted for those who appreciate the finest things in life.</p>
			</div>
		</section>

		// Collections Showcase
		<section class="page-content">
			<div class="collections-showcase">
				// Timepieces Collection
				<div class="showcase-item" data-animate="fade-up">
					<div class="showcase-image image-reveal">
						<img src="https://images.unsplash.com/photo-1547996160-81dfa63595aa?w=900&q=85" alt="Luxury Timepieces" loading="lazy"/>
					</div>
					<div class="showcase-content">
						<span class="showcase-label">Horlogerie</span>
						<h2 class="showcase-title">Fine Timepieces</h2>
						<p class="showcase-description">Our timepiece collection represents the apex of horological artistry. Each watch is a masterpiece of precision engineering and aesthetic perfection, destined to be treasured for generations.</p>
						<ul class="showcase-features">
							<li>Swiss-made movements with COSC certification</li>
							<li>Sapphire crystal with anti-reflective coating</li>
							<li>18k gold and platinum cases</li>
							<li>Water resistant to 300 meters</li>
						</ul>
						<a href="/collections/timepieces" class="btn-primary">
							<span>Explore Timepieces</span>
							<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
								<line x1="5" y1="12" x2="19" y2="12"></line>
								<polyline points="12 5 19 12 12 19"></polyline>
							</svg>
						</a>
					</div>
				</div>

				// Signature Collection
				<div class="showcase-item reverse" data-animate="fade-up">
					<div class="showcase-image image-reveal">
						<img src="https://images.unsplash.com/photo-1507679799987-c73779587ccf?w=900&q=85" alt="Signature Collection" loading="lazy"/>
					</div>
					<div class="showcase-content">
						<span class="showcase-label">Signature</span>
						<h2 class="showcase-title">Tailored Suiting</h2>
						<p class="showcase-description">Our flagship collection embodies the pinnacle of sartorial excellence. Each piece is meticulously crafted from the world's finest fabrics, featuring hand-finished details that define true luxury.</p>
						<ul class="showcase-features">
							<li>Hand-stitched Milanese buttonholes</li>
							<li>Full-canvas construction</li>
							<li>Exclusive Super 180s wool from Italy</li>
							<li>Mother of pearl buttons</li>
						</ul>
						<a href="/collections/signature" class="btn-primary">
							<span>Explore Signature</span>
							<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
								<line x1="5" y1="12" x2="19" y2="12"></line>
								<polyline points="12 5 19 12 12 19"></polyline>
							</svg>
						</a>
					</div>
				</div>

				// Heritage Collection
				<div class="showcase-item" data-animate="fade-up">
					<div class="showcase-image image-reveal">
						<img src="https://images.unsplash.com/photo-1617127365659-c47fa864d8bc?w=900&q=85" alt="Heritage Collection" loading="lazy"/>
					</div>
					<div class="showcase-content">
						<span class="showcase-label">Heritage</span>
						<h2 class="showcase-title">Timeless Classics</h2>
						<p class="showcase-description">Drawing inspiration from our storied past, the Heritage collection celebrates timeless designs reimagined for the modern gentleman. Classic silhouettes meet contemporary craftsmanship.</p>
						<ul class="showcase-features">
							<li>Archival patterns and designs</li>
							<li>Traditional construction methods</li>
							<li>Limited edition seasonal pieces</li>
							<li>Numbered certificates of authenticity</li>
						</ul>
						<a href="/collections/heritage" class="btn-primary">
							<span>Explore Heritage</span>
							<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
								<line x1="5" y1="12" x2="19" y2="12"></line>
								<polyline points="12 5 19 12 12 19"></polyline>
							</svg>
						</a>
					</div>
				</div>

				// Fine Jewelry Collection
				<div class="showcase-item reverse" data-animate="fade-up">
					<div class="showcase-image image-reveal">
						<img src="https://images.unsplash.com/photo-1603561591411-07134e71a2a9?w=900&q=85" alt="Fine Jewelry" loading="lazy"/>
					</div>
					<div class="showcase-content">
						<span class="showcase-label">Precious</span>
						<h2 class="showcase-title">Fine Jewelry</h2>
						<p class="showcase-description">Exquisite jewelry crafted from the finest precious metals and ethically sourced gemstones. Each piece is a statement of refined taste and enduring value.</p>
						<ul class="showcase-features">
							<li>18k gold and platinum settings</li>
							<li>GIA-certified diamonds</li>
							<li>Hand-engraved details</li>
							<li>Lifetime warranty on craftsmanship</li>
						</ul>
						<a href="/collections/jewelry" class="btn-primary">
							<span>Explore Jewelry</span>
							<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
								<line x1="5" y1="12" x2="19" y2="12"></line>
								<polyline points="12 5 19 12 12 19"></polyline>
							</svg>
						</a>
					</div>
				</div>

				// Accessories Collection
				<div class="showcase-item" data-animate="fade-up">
					<div class="showcase-image image-reveal">
						<img src="https://images.unsplash.com/photo-1553062407-98eeb64c6a62?w=900&q=85" alt="Leather Accessories" loading="lazy"/>
					</div>
					<div class="showcase-content">
						<span class="showcase-label">Artisan</span>
						<h2 class="showcase-title">Leather & Accessories</h2>
						<p class="showcase-description">Hand-selected materials meet artisanal craftsmanship in our accessories collection. Each item is designed to complement and complete the distinguished gentleman's wardrobe.</p>
						<ul class="showcase-features">
							<li>Full-grain Italian leather</li>
							<li>Hand-stitched construction</li>
							<li>Solid brass hardware</li>
							<li>Personalization available</li>
						</ul>
						<a href="/collections/accessories" class="btn-primary">
							<span>Explore Accessories</span>
							<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
								<line x1="5" y1="12" x2="19" y2="12"></line>
								<polyline points="12 5 19 12 12 19"></polyline>
							</svg>
						</a>
					</div>
				</div>
			</div>
		</section>

		// CTA Section
		<section class="bespoke-section">
			<div class="bespoke-background">
				<img src="https://images.unsplash.com/photo-1441984904996-e0b6ba687e04?w=1920&q=90" alt="Luxury boutique" loading="lazy"/>
				<div class="bespoke-overlay"></div>
			</div>
			<div class="bespoke-content" data-animate="fade-up">
				<span class="bespoke-label">Personal Shopping</span>
				<h2 class="bespoke-title">Private Appointments</h2>
				<p class="bespoke-text">Experience our collections in an intimate setting with a dedicated style consultant. Book a private appointment at our flagship boutique.</p>
				<a href="/appointments" class="btn-gold">
					<span>Book Appointment</span>
				</a>
			</div>
		</section>
	}
}

templ CollectionDetail(slug string) {
	@layouts.Base(meta.New("Collection | " + slug, "Explore our curated collection of luxury pieces.")) {
		<section class="page-hero">
			<div class="page-hero-content" data-animate="fade-up">
				<span class="page-label">Collection</span>
				<h1 class="page-title capitalize">{ slug }</h1>
				<p class="page-subtitle">Discover our finest selection of luxury pieces.</p>
			</div>
		</section>
		<section class="featured-section">
			<div class="products-grid">
				@ProductCard("Platinum Chronograph", "$24,500", "https://images.unsplash.com/photo-1587836374828-4dbafa94cf0e?w=600&q=85", "/product/platinum-chronograph")
				@ProductCard("Royal Oak Gold", "$48,900", "https://images.unsplash.com/photo-1622434641406-a158123450f9?w=600&q=85", "/product/royal-oak-gold")
				@ProductCard("Submariner Classic", "$32,750", "https://images.unsplash.com/photo-1548171915-e79a380a2a4b?w=600&q=85", "/product/submariner-classic")
				@ProductCard("Datejust Silver", "$18,200", "https://images.unsplash.com/photo-1533139502658-0198f920d8e8?w=600&q=85", "/product/datejust-silver")
				@ProductCard("GMT Master II", "$28,500", "https://images.unsplash.com/photo-1523170335258-f5ed11844a49?w=600&q=85", "/product/gmt-master")
				@ProductCard("Day-Date Platinum", "$52,000", "https://images.unsplash.com/photo-1547996160-81dfa63595aa?w=600&q=85", "/product/day-date-platinum")
				@ProductCard("Explorer Heritage", "$15,800", "https://images.unsplash.com/photo-1539874754764-5a96559165b0?w=600&q=85", "/product/explorer-heritage")
				@ProductCard("Yacht-Master Gold", "$38,900", "https://images.unsplash.com/photo-1587925358603-c2eea5305bbc?w=600&q=85", "/product/yacht-master")
			</div>
		</section>
	}
}
