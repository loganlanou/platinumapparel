package pages

import (
	"platinumapparel/internal/meta"
	"platinumapparel/templates/layouts"
)

templ Home() {
	@layouts.Base(meta.New("Luxury Menswear & Timepieces", "Discover the epitome of luxury menswear, fine jewelry, and prestigious timepieces. Handcrafted excellence for the distinguished gentleman.")) {
		// Hero Section - Cinematic Full Screen
		<section class="hero">
			<div class="hero-background">
				<img src="https://images.unsplash.com/photo-1523170335258-f5ed11844a49?w=1920&q=90" alt="Luxury Rolex timepiece" class="hero-bg-image"/>
			</div>
			<div class="hero-overlay"></div>
			<div class="hero-content" data-animate="fade-up">
				<span class="hero-label">The 2025 Collection</span>
				<h1 class="hero-title">
					<span class="title-line">Timeless</span>
					<span class="title-line accent">Elegance</span>
				</h1>
				<p class="hero-subtitle">Where master craftsmanship meets eternal distinction. Discover pieces that transcend generations.</p>
				<div class="hero-actions">
					<a href="/collections" class="btn-primary">
						<span>Explore Collections</span>
						<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
							<line x1="5" y1="12" x2="19" y2="12"></line>
							<polyline points="12 5 19 12 12 19"></polyline>
						</svg>
					</a>
					<a href="/heritage" class="btn-secondary"><span>Our Heritage</span></a>
				</div>
			</div>
			<div class="hero-scroll">
				<span>Scroll to discover</span>
				<div class="scroll-indicator"></div>
			</div>
		</section>

		// Collections Grid - Magazine Style
		<section class="collections-section" id="collections">
			<div class="section-header" data-animate="fade-up">
				<span class="section-label">Curated Excellence</span>
				<h2 class="section-title">Our Collections</h2>
			</div>
			<div class="collections-grid">
				// Large Timepiece Card
				<a href="/collections/timepieces" class="collection-card large" data-animate="fade-up">
					<div class="card-image">
						<img src="https://images.unsplash.com/photo-1547996160-81dfa63595aa?w=800&q=85" alt="Luxury Timepieces" loading="lazy"/>
					</div>
					<div class="card-overlay"></div>
					<div class="card-content">
						<span class="card-label">Horlogerie</span>
						<h3 class="card-title">Fine Timepieces</h3>
						<p class="card-description">Swiss precision meets artistic mastery. Movements that define excellence.</p>
						<span class="card-arrow">
							Discover
							<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
								<line x1="5" y1="12" x2="19" y2="12"></line>
								<polyline points="12 5 19 12 12 19"></polyline>
							</svg>
						</span>
					</div>
				</a>
				// Tailoring Card
				<a href="/collections/signature" class="collection-card" data-animate="fade-up" data-delay="100">
					<div class="card-image">
						<img src="https://images.unsplash.com/photo-1594938298603-c8148c4dae35?w=600&q=85" alt="Bespoke Tailoring" loading="lazy"/>
					</div>
					<div class="card-overlay"></div>
					<div class="card-content">
						<span class="card-label">Signature</span>
						<h3 class="card-title">Tailored Suits</h3>
						<span class="card-arrow">
							Explore
							<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
								<line x1="5" y1="12" x2="19" y2="12"></line>
								<polyline points="12 5 19 12 12 19"></polyline>
							</svg>
						</span>
					</div>
				</a>
				// Jewelry Card
				<a href="/collections/jewelry" class="collection-card" data-animate="fade-up" data-delay="200">
					<div class="card-image">
						<img src="https://images.unsplash.com/photo-1603561591411-07134e71a2a9?w=600&q=85" alt="Fine Jewelry" loading="lazy"/>
					</div>
					<div class="card-overlay"></div>
					<div class="card-content">
						<span class="card-label">Precious</span>
						<h3 class="card-title">Fine Jewelry</h3>
						<span class="card-arrow">
							Explore
							<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
								<line x1="5" y1="12" x2="19" y2="12"></line>
								<polyline points="12 5 19 12 12 19"></polyline>
							</svg>
						</span>
					</div>
				</a>
				// Wide Accessories Card
				<a href="/collections/accessories" class="collection-card wide" data-animate="fade-up" data-delay="300">
					<div class="card-image">
						<img src="https://images.unsplash.com/photo-1553062407-98eeb64c6a62?w=1000&q=85" alt="Leather Goods & Accessories" loading="lazy"/>
					</div>
					<div class="card-overlay"></div>
					<div class="card-content">
						<span class="card-label">Artisan</span>
						<h3 class="card-title">Leather & Accessories</h3>
						<p class="card-description">Hand-selected materials, artisanal craftsmanship for the discerning gentleman</p>
						<span class="card-arrow">
							Discover
							<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
								<line x1="5" y1="12" x2="19" y2="12"></line>
								<polyline points="12 5 19 12 12 19"></polyline>
							</svg>
						</span>
					</div>
				</a>
			</div>
		</section>

		// Featured Timepieces Section
		<section class="featured-section">
			<div class="section-header" data-animate="fade-up">
				<span class="section-label">Horlogerie</span>
				<h2 class="section-title">Featured Timepieces</h2>
			</div>
			<div class="products-grid">
				@ProductCard("Perpetual Chronograph", "$24,500", "https://images.unsplash.com/photo-1587836374828-4dbafa94cf0e?w=600&q=85", "/product/perpetual-chronograph")
				@ProductCard("Royal Oak Platinum", "$48,900", "https://images.unsplash.com/photo-1622434641406-a158123450f9?w=600&q=85", "/product/royal-oak-platinum")
				@ProductCard("Submariner Gold", "$32,750", "https://images.unsplash.com/photo-1548171915-e79a380a2a4b?w=600&q=85", "/product/submariner-gold")
				@ProductCard("Datejust Classic", "$18,200", "https://images.unsplash.com/photo-1533139502658-0198f920d8e8?w=600&q=85", "/product/datejust-classic")
			</div>
			<div class="section-cta" data-animate="fade-up">
				<a href="/collections/timepieces" class="btn-outline"><span>View All Timepieces</span></a>
			</div>
		</section>

		// Luxury Banner - Full Width
		<section class="luxury-banner">
			<div class="luxury-banner-bg">
				<img src="https://images.unsplash.com/photo-1507679799987-c73779587ccf?w=1920&q=90" alt="Bespoke tailoring" loading="lazy"/>
			</div>
			<div class="luxury-banner-overlay"></div>
			<div class="luxury-banner-content" data-animate="fade-up">
				<span class="luxury-banner-label">Bespoke Excellence</span>
				<h2 class="luxury-banner-title">The Art of<br/>Tailoring</h2>
				<p class="luxury-banner-text">Every stitch tells a story. Our master tailors bring decades of expertise to create garments that fit not just your body, but your life.</p>
				<a href="/bespoke" class="btn-primary">
					<span>Book Consultation</span>
					<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
						<line x1="5" y1="12" x2="19" y2="12"></line>
						<polyline points="12 5 19 12 12 19"></polyline>
					</svg>
				</a>
			</div>
		</section>

		// Featured Suits & Menswear
		<section class="featured-section">
			<div class="section-header" data-animate="fade-up">
				<span class="section-label">Sartorial Excellence</span>
				<h2 class="section-title">Signature Menswear</h2>
			</div>
			<div class="products-grid">
				@ProductCard("Midnight Tuxedo", "$4,850", "https://images.unsplash.com/photo-1593030761757-71fae45fa0e7?w=600&q=85", "/product/midnight-tuxedo")
				@ProductCard("Navy Pinstripe Suit", "$3,200", "https://images.unsplash.com/photo-1617127365659-c47fa864d8bc?w=600&q=85", "/product/navy-pinstripe-suit")
				@ProductCard("Charcoal Wool Blazer", "$1,950", "https://images.unsplash.com/photo-1594938298603-c8148c4dae35?w=600&q=85", "/product/charcoal-wool-blazer")
				@ProductCard("Italian Silk Tie", "$295", "https://images.unsplash.com/photo-1589756823695-278bc923f962?w=600&q=85", "/product/italian-silk-tie")
			</div>
			<div class="section-cta" data-animate="fade-up">
				<a href="/collections/signature" class="btn-outline"><span>View All Menswear</span></a>
			</div>
		</section>

		// Craftsmanship Banner
		<section class="craft-banner">
			<div class="craft-content" data-animate="fade-up">
				<span class="craft-label">The Art of Excellence</span>
				<h2 class="craft-title">Uncompromising Craftsmanship</h2>
				<p class="craft-text">Each piece in our collection represents hundreds of hours of meticulous handwork by master artisans who have dedicated their lives to perfecting their craft. From the selection of the finest materials to the final quality inspection, excellence is non-negotiable.</p>
				<a href="/craft" class="btn-primary">
					<span>Discover The Craft</span>
				</a>
			</div>
			<div class="craft-stats">
				<div class="stat" data-animate="fade-up" data-delay="100">
					<span class="stat-number">150+</span>
					<span class="stat-label">Hours per piece</span>
				</div>
				<div class="stat" data-animate="fade-up" data-delay="200">
					<span class="stat-number">47</span>
					<span class="stat-label">Master artisans</span>
				</div>
				<div class="stat" data-animate="fade-up" data-delay="300">
					<span class="stat-number">1892</span>
					<span class="stat-label">Year established</span>
				</div>
			</div>
		</section>

		// Fine Jewelry Section
		<section class="featured-section">
			<div class="section-header" data-animate="fade-up">
				<span class="section-label">Precious Metals</span>
				<h2 class="section-title">Fine Jewelry</h2>
			</div>
			<div class="products-grid">
				@ProductCard("Gold Signet Ring", "$2,850", "https://images.unsplash.com/photo-1605100804763-247f67b3557e?w=600&q=85", "/product/gold-signet-ring")
				@ProductCard("Diamond Cufflinks", "$4,200", "https://images.unsplash.com/photo-1590548784585-643d2b9f2925?w=600&q=85", "/product/diamond-cufflinks")
				@ProductCard("Platinum Chain", "$3,500", "https://images.unsplash.com/photo-1599643478518-a784e5dc4c8f?w=600&q=85", "/product/platinum-chain")
				@ProductCard("Onyx Bracelet", "$1,850", "https://images.unsplash.com/photo-1611591437281-460bfbe1220a?w=600&q=85", "/product/onyx-bracelet")
			</div>
			<div class="section-cta" data-animate="fade-up">
				<a href="/collections/jewelry" class="btn-outline"><span>View All Jewelry</span></a>
			</div>
		</section>

		// Testimonials
		<section class="testimonials-section">
			<div class="section-header" data-animate="fade-up">
				<span class="section-label">Distinguished Clientele</span>
				<h2 class="section-title">Client Testimonials</h2>
			</div>
			<div class="testimonial-carousel">
				<div class="testimonial-track" id="testimonialTrack">
					@Testimonial("The attention to detail is extraordinary. My bespoke suit from Platinum is the finest I've ever owned. The fit is impeccable.", "James Richardson", "CEO, Sterling Holdings")
					@Testimonial("Their timepieces are not merely watches—they are heirlooms. Exceptional craftsmanship in every way.", "Michael Chen", "Private Collector")
					@Testimonial("From consultation to delivery, the experience was impeccable. This is what true luxury service means.", "David Ashford", "Private Client")
				</div>
				<div class="testimonial-nav">
					<button id="prevTestimonial" class="nav-btn" aria-label="Previous testimonial">
						<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
							<polyline points="15 18 9 12 15 6"></polyline>
						</svg>
					</button>
					<div class="testimonial-dots" id="testimonialDots">
						<button class="dot active" aria-label="Testimonial 1"></button>
						<button class="dot" aria-label="Testimonial 2"></button>
						<button class="dot" aria-label="Testimonial 3"></button>
					</div>
					<button id="nextTestimonial" class="nav-btn" aria-label="Next testimonial">
						<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
							<polyline points="9 18 15 12 9 6"></polyline>
						</svg>
					</button>
				</div>
			</div>
		</section>

		// Leather Goods Section
		<section class="featured-section">
			<div class="section-header" data-animate="fade-up">
				<span class="section-label">Artisan Leather</span>
				<h2 class="section-title">Leather Accessories</h2>
			</div>
			<div class="products-grid">
				@ProductCard("Crocodile Wallet", "$1,450", "https://images.unsplash.com/photo-1627123424574-724758594e93?w=600&q=85", "/product/crocodile-wallet")
				@ProductCard("Executive Briefcase", "$2,800", "https://images.unsplash.com/photo-1548036328-c9fa89d128fa?w=600&q=85", "/product/executive-briefcase")
				@ProductCard("Calfskin Belt", "$485", "https://images.unsplash.com/photo-1553062407-98eeb64c6a62?w=600&q=85", "/product/calfskin-belt")
				@ProductCard("Travel Duffle", "$3,200", "https://images.unsplash.com/photo-1553062407-98eeb64c6a62?w=600&q=85", "/product/travel-duffle")
			</div>
			<div class="section-cta" data-animate="fade-up">
				<a href="/collections/accessories" class="btn-outline"><span>View All Accessories</span></a>
			</div>
		</section>

		// Bespoke CTA
		<section class="bespoke-section">
			<div class="bespoke-background">
				<img src="https://images.unsplash.com/photo-1558618666-fcd25c85cd64?w=1920&q=90" alt="Bespoke experience" loading="lazy"/>
				<div class="bespoke-overlay"></div>
			</div>
			<div class="bespoke-content" data-animate="fade-up">
				<span class="bespoke-label">Personalized Excellence</span>
				<h2 class="bespoke-title">The Bespoke Experience</h2>
				<p class="bespoke-text">Commission a piece as unique as you are. Our master craftsmen will guide you through every detail, from fabric selection to final fitting. Experience luxury tailored to perfection.</p>
				<a href="/bespoke" class="btn-gold">
					<span>Begin Your Journey</span>
				</a>
			</div>
		</section>
	}
}

templ ProductCard(name, price, image, href string) {
	<a href={ templ.SafeURL(href) } class="product-card" data-animate="fade-up">
		<div class="product-image">
			<img src={ image } alt={ name } loading="lazy"/>
			<div class="product-overlay">
				<span class="quick-view">Quick View</span>
			</div>
		</div>
		<div class="product-info">
			<h3 class="product-name">{ name }</h3>
			<span class="product-price">{ price }</span>
		</div>
	</a>
}

templ Testimonial(quote, name, title string) {
	<div class="testimonial">
		<svg class="testimonial-icon" xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="currentColor">
			<path d="M14.017 21v-7.391c0-5.704 3.731-9.57 8.983-10.609l.995 2.151c-2.432.917-3.995 3.638-3.995 5.849h4v10h-9.983zm-14.017 0v-7.391c0-5.704 3.748-9.57 9-10.609l.996 2.151c-2.433.917-3.996 3.638-3.996 5.849h3.983v10h-9.983z"/>
		</svg>
		<blockquote class="testimonial-quote">{ quote }</blockquote>
		<div class="testimonial-author">
			<span class="author-name">{ name }</span>
			<span class="author-title">{ title }</span>
		</div>
	</div>
}
