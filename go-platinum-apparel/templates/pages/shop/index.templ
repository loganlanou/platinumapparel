package shop

import (
	"platinumapparel/internal/meta"
	"platinumapparel/templates/layouts"
	"platinumapparel/templates/pages"
)

templ Index() {
	@layouts.Base(meta.New("Shop", "Browse our complete collection of luxury menswear, timepieces, and fine jewelry.")) {
		// Hero
		<section class="page-hero shop-hero">
			<div class="page-hero-content" data-animate="fade-up">
				<span class="page-label">Shop</span>
				<h1 class="page-title">All Products</h1>
				<p class="page-subtitle">Browse our complete collection of luxury pieces, curated for the distinguished gentleman.</p>
			</div>
		</section>

		// Shop Content
		<section class="shop-content">
			<aside class="shop-filters" data-animate="fade-up">
				<div class="filter-group">
					<h3 class="filter-title">Category</h3>
					<ul class="filter-options">
						<li><a href="/shop" class="filter-link active">All Products</a></li>
						<li><a href="/shop/category/watches" class="filter-link">Timepieces</a></li>
						<li><a href="/shop/category/jewelry" class="filter-link">Fine Jewelry</a></li>
						<li><a href="/shop/category/clothing" class="filter-link">Menswear</a></li>
						<li><a href="/shop/category/accessories" class="filter-link">Accessories</a></li>
					</ul>
				</div>
				<div class="filter-group">
					<h3 class="filter-title">Collection</h3>
					<ul class="filter-options">
						<li><a href="/shop?collection=signature" class="filter-link">Signature</a></li>
						<li><a href="/shop?collection=heritage" class="filter-link">Heritage</a></li>
						<li><a href="/shop?collection=artisan" class="filter-link">Artisan</a></li>
						<li><a href="/shop?collection=limited" class="filter-link">Limited Edition</a></li>
					</ul>
				</div>
				<div class="filter-group">
					<h3 class="filter-title">Price Range</h3>
					<ul class="filter-options">
						<li><a href="/shop?price=under-1000" class="filter-link">Under $1,000</a></li>
						<li><a href="/shop?price=1000-5000" class="filter-link">$1,000 - $5,000</a></li>
						<li><a href="/shop?price=5000-15000" class="filter-link">$5,000 - $15,000</a></li>
						<li><a href="/shop?price=15000-50000" class="filter-link">$15,000 - $50,000</a></li>
						<li><a href="/shop?price=over-50000" class="filter-link">Over $50,000</a></li>
					</ul>
				</div>
			</aside>

			<main class="shop-products">
				<div class="shop-toolbar">
					<span class="product-count">Showing 16 of 48 products</span>
					<select class="sort-select">
						<option value="featured">Featured</option>
						<option value="newest">Newest Arrivals</option>
						<option value="price-low">Price: Low to High</option>
						<option value="price-high">Price: High to Low</option>
					</select>
				</div>

				<div class="products-grid">
					// Timepieces
					@pages.ProductCard("Perpetual Chronograph", "$24,500", "https://images.unsplash.com/photo-1587836374828-4dbafa94cf0e?w=600&q=85", "/product/perpetual-chronograph")
					@pages.ProductCard("Royal Oak Platinum", "$48,900", "https://images.unsplash.com/photo-1622434641406-a158123450f9?w=600&q=85", "/product/royal-oak-platinum")
					@pages.ProductCard("Submariner Gold", "$32,750", "https://images.unsplash.com/photo-1548171915-e79a380a2a4b?w=600&q=85", "/product/submariner-gold")
					@pages.ProductCard("Datejust Classic", "$18,200", "https://images.unsplash.com/photo-1533139502658-0198f920d8e8?w=600&q=85", "/product/datejust-classic")

					// Jewelry
					@pages.ProductCard("Gold Signet Ring", "$2,850", "https://images.unsplash.com/photo-1605100804763-247f67b3557e?w=600&q=85", "/product/gold-signet-ring")
					@pages.ProductCard("Diamond Cufflinks", "$4,200", "https://images.unsplash.com/photo-1590548784585-643d2b9f2925?w=600&q=85", "/product/diamond-cufflinks")
					@pages.ProductCard("Platinum Chain", "$3,500", "https://images.unsplash.com/photo-1599643478518-a784e5dc4c8f?w=600&q=85", "/product/platinum-chain")
					@pages.ProductCard("Onyx Bracelet", "$1,850", "https://images.unsplash.com/photo-1611591437281-460bfbe1220a?w=600&q=85", "/product/onyx-bracelet")

					// Menswear
					@pages.ProductCard("Midnight Tuxedo", "$4,850", "https://images.unsplash.com/photo-1593030761757-71fae45fa0e7?w=600&q=85", "/product/midnight-tuxedo")
					@pages.ProductCard("Navy Pinstripe Suit", "$3,200", "https://images.unsplash.com/photo-1617127365659-c47fa864d8bc?w=600&q=85", "/product/navy-pinstripe-suit")
					@pages.ProductCard("Charcoal Wool Blazer", "$1,950", "https://images.unsplash.com/photo-1594938298603-c8148c4dae35?w=600&q=85", "/product/charcoal-wool-blazer")
					@pages.ProductCard("Italian Silk Tie", "$295", "https://images.unsplash.com/photo-1589756823695-278bc923f962?w=600&q=85", "/product/italian-silk-tie")

					// Accessories
					@pages.ProductCard("Crocodile Wallet", "$1,450", "https://images.unsplash.com/photo-1627123424574-724758594e93?w=600&q=85", "/product/crocodile-wallet")
					@pages.ProductCard("Executive Briefcase", "$2,800", "https://images.unsplash.com/photo-1548036328-c9fa89d128fa?w=600&q=85", "/product/executive-briefcase")
					@pages.ProductCard("Calfskin Belt", "$485", "https://images.unsplash.com/photo-1553062407-98eeb64c6a62?w=600&q=85", "/product/calfskin-belt")
					@pages.ProductCard("Travel Duffle", "$3,200", "https://images.unsplash.com/photo-1553062407-98eeb64c6a62?w=600&q=85", "/product/travel-duffle")
				</div>

				<div class="section-cta" data-animate="fade-up">
					<a href="/shop?page=2" class="btn-outline"><span>Load More Products</span></a>
				</div>
			</main>
		</section>
	}
}

templ Category(category string) {
	@layouts.Base(meta.New(category + " | Shop", "Browse our " + category + " collection.")) {
		<section class="page-hero shop-hero">
			<div class="page-hero-content" data-animate="fade-up">
				<span class="page-label">Category</span>
				<h1 class="page-title capitalize">{ category }</h1>
				<p class="page-subtitle">Discover our finest { category } collection.</p>
			</div>
		</section>
		<section class="featured-section">
			<div class="products-grid">
				@pages.ProductCard("Perpetual Chronograph", "$24,500", "https://images.unsplash.com/photo-1587836374828-4dbafa94cf0e?w=600&q=85", "/product/perpetual-chronograph")
				@pages.ProductCard("Royal Oak Platinum", "$48,900", "https://images.unsplash.com/photo-1622434641406-a158123450f9?w=600&q=85", "/product/royal-oak-platinum")
				@pages.ProductCard("Submariner Gold", "$32,750", "https://images.unsplash.com/photo-1548171915-e79a380a2a4b?w=600&q=85", "/product/submariner-gold")
				@pages.ProductCard("Datejust Classic", "$18,200", "https://images.unsplash.com/photo-1533139502658-0198f920d8e8?w=600&q=85", "/product/datejust-classic")
			</div>
		</section>
	}
}
