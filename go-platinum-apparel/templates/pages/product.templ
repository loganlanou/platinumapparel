package pages

import (
	"platinumapparel/internal/meta"
	"platinumapparel/templates/layouts"
	"strings"
)

templ ProductDetail(slug string) {
	@layouts.Base(meta.New(formatProductName(slug), "Discover the craftsmanship and details of this exceptional piece.").AsProduct()) {
		// Breadcrumb
		<nav class="px-4 lg:px-8 py-4 text-sm text-muted border-b border-border">
			<a href="/" class="hover:text-gold transition-colors">Home</a>
			<span class="mx-2 text-border">/</span>
			<a href="/shop" class="hover:text-gold transition-colors">Shop</a>
			<span class="mx-2 text-border">/</span>
			<span class="text-secondary capitalize">{ formatProductName(slug) }</span>
		</nav>

		// Main Product Section - Two Column Grid
		<section class="max-w-7xl mx-auto px-4 lg:px-8 py-8 lg:py-16">
			<div class="grid grid-cols-1 lg:grid-cols-2 gap-8 lg:gap-16">

				// Left Column - Image Gallery
				<div class="w-full">
					// Main Image
					<div class="relative aspect-square bg-card border border-border overflow-hidden mb-4">
						<img
							id="main-product-image"
							src={ getProductImage(slug, "main") }
							alt={ formatProductName(slug) }
							class="w-full h-full object-cover transition-transform duration-500 hover:scale-105"
						/>
						<button class="absolute bottom-4 right-4 w-10 h-10 bg-dark/80 border border-border text-secondary flex items-center justify-center hover:bg-gold hover:text-dark hover:border-gold transition-all">
							<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
								<circle cx="11" cy="11" r="8"></circle>
								<path d="m21 21-4.35-4.35"></path>
								<path d="M11 8v6"></path>
								<path d="M8 11h6"></path>
							</svg>
						</button>
					</div>

					// Thumbnail Grid
					<div class="grid grid-cols-4 gap-3">
						<button class="thumb-btn aspect-square border-2 border-gold overflow-hidden" onclick="changeMainImage(this, 'main')">
							<img src={ getProductImage(slug, "thumb1") } alt="View 1" class="w-full h-full object-cover"/>
						</button>
						<button class="thumb-btn aspect-square border-2 border-border overflow-hidden hover:border-muted transition-colors" onclick="changeMainImage(this, 'thumb2')">
							<img src={ getProductImage(slug, "thumb2") } alt="View 2" class="w-full h-full object-cover opacity-70 hover:opacity-100 transition-opacity"/>
						</button>
						<button class="thumb-btn aspect-square border-2 border-border overflow-hidden hover:border-muted transition-colors" onclick="changeMainImage(this, 'thumb3')">
							<img src={ getProductImage(slug, "thumb3") } alt="View 3" class="w-full h-full object-cover opacity-70 hover:opacity-100 transition-opacity"/>
						</button>
						<button class="thumb-btn aspect-square border-2 border-border overflow-hidden hover:border-muted transition-colors" onclick="changeMainImage(this, 'thumb4')">
							<img src={ getProductImage(slug, "thumb4") } alt="View 4" class="w-full h-full object-cover opacity-70 hover:opacity-100 transition-opacity"/>
						</button>
					</div>
				</div>

				// Right Column - Product Details
				<div class="w-full flex flex-col">
					// Product Header
					<div class="mb-6 pb-6 border-b border-border">
						<span class="inline-block text-xs tracking-[0.3em] uppercase text-gold mb-2">Signature Collection</span>
						<h1 class="font-display text-3xl lg:text-4xl text-secondary mb-4 capitalize">{ formatProductName(slug) }</h1>
						<div class="font-display text-2xl text-gold">{ getProductPrice(slug) }</div>
					</div>

					// Description
					<div class="mb-8">
						<p class="text-muted-light leading-relaxed">{ getProductDescription(slug) }</p>
					</div>

					// Specifications
					<div class="mb-8 p-6 bg-card border border-border">
						<h3 class="text-xs tracking-[0.2em] uppercase text-gold mb-4">Specifications</h3>
						<div class="grid grid-cols-2 gap-4">
							@productSpecsInline(slug)
						</div>
					</div>

					// Quantity & Add to Cart
					<div class="flex flex-col sm:flex-row gap-4 mb-4">
						<div class="flex items-center border border-border bg-card">
							<button onclick="decrementQty()" class="w-12 h-12 text-secondary text-xl hover:bg-gold hover:text-dark transition-all">−</button>
							<input type="number" id="product-qty" value="1" min="1" max="10" readonly class="w-16 h-12 bg-transparent border-x border-border text-center text-secondary"/>
							<button onclick="incrementQty()" class="w-12 h-12 text-secondary text-xl hover:bg-gold hover:text-dark transition-all">+</button>
						</div>
						<button
							class="flex-1 h-12 bg-gold text-dark font-medium tracking-wider uppercase text-sm hover:bg-gold-light transition-all"
							hx-post="/cart/add"
							hx-vals='{"product_id": "1", "quantity": "1"}'
							hx-swap="none"
						>
							Add to Cart
						</button>
					</div>

					// Wishlist Button
					<button class="w-full h-12 border border-border text-secondary flex items-center justify-center gap-3 hover:border-gold hover:text-gold transition-all mb-8">
						<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
							<path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path>
						</svg>
						<span class="text-sm tracking-wider uppercase">Add to Wishlist</span>
					</button>

					// Services Grid
					<div class="grid grid-cols-2 gap-4 p-4 bg-card border border-border mb-8">
						<div class="flex items-center gap-3 text-sm text-muted-light">
							<svg class="text-gold flex-shrink-0" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
								<rect x="1" y="3" width="22" height="5" rx="2"></rect>
								<path d="M21 8v13a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8"></path>
								<path d="M10 12h4"></path>
							</svg>
							<span>Free Shipping</span>
						</div>
						<div class="flex items-center gap-3 text-sm text-muted-light">
							<svg class="text-gold flex-shrink-0" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
								<path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path>
							</svg>
							<span>Gift Packaging</span>
						</div>
						<div class="flex items-center gap-3 text-sm text-muted-light">
							<svg class="text-gold flex-shrink-0" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
								<path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
							</svg>
							<span>5-Year Warranty</span>
						</div>
						<div class="flex items-center gap-3 text-sm text-muted-light">
							<svg class="text-gold flex-shrink-0" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
								<polyline points="9 11 12 14 22 4"></polyline>
								<path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"></path>
							</svg>
							<span>Free Returns</span>
						</div>
					</div>

					// Accordion
					<div class="border-t border-border">
						<details class="border-b border-border group">
							<summary class="flex items-center justify-between py-4 cursor-pointer text-secondary hover:text-gold transition-colors">
								<span class="text-sm">Product Details</span>
								<svg class="text-gold transition-transform group-open:rotate-180" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
									<polyline points="6 9 12 15 18 9"></polyline>
								</svg>
							</summary>
							<div class="pb-4 text-sm text-muted-light leading-relaxed">
								Each piece in our Signature Collection represents the pinnacle of craftsmanship. Hand-finished by our master artisans, this item showcases meticulous attention to detail and the finest materials sourced from around the world.
							</div>
						</details>
						<details class="border-b border-border group">
							<summary class="flex items-center justify-between py-4 cursor-pointer text-secondary hover:text-gold transition-colors">
								<span class="text-sm">Shipping & Returns</span>
								<svg class="text-gold transition-transform group-open:rotate-180" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
									<polyline points="6 9 12 15 18 9"></polyline>
								</svg>
							</summary>
							<div class="pb-4 text-sm text-muted-light leading-relaxed">
								Complimentary express shipping on all orders. Items arrive in our signature luxury packaging. Returns accepted within 30 days of delivery in original condition.
							</div>
						</details>
						<details class="border-b border-border group">
							<summary class="flex items-center justify-between py-4 cursor-pointer text-secondary hover:text-gold transition-colors">
								<span class="text-sm">Care Instructions</span>
								<svg class="text-gold transition-transform group-open:rotate-180" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
									<polyline points="6 9 12 15 18 9"></polyline>
								</svg>
							</summary>
							<div class="pb-4 text-sm text-muted-light leading-relaxed">
								Store in a cool, dry place away from direct sunlight. Clean with a soft, lint-free cloth. For timepieces, service every 3-5 years to maintain optimal performance.
							</div>
						</details>
					</div>
				</div>
			</div>
		</section>

		// Related Products
		<section class="py-16 lg:py-24 px-4 lg:px-8 bg-dark border-t border-border">
			<div class="max-w-7xl mx-auto">
				<div class="text-center mb-12">
					<span class="inline-block text-xs tracking-[0.3em] uppercase text-gold mb-3">You May Also Like</span>
					<h2 class="font-display text-3xl lg:text-4xl text-secondary">Related Products</h2>
				</div>
				<div class="grid grid-cols-2 lg:grid-cols-4 gap-4 lg:gap-6">
					@ProductCard("Royal Oak Platinum", "$48,900", "https://images.unsplash.com/photo-1622434641406-a158123450f9?w=600&q=85", "/product/royal-oak-platinum")
					@ProductCard("Submariner Gold", "$32,750", "https://images.unsplash.com/photo-1548171915-e79a380a2a4b?w=600&q=85", "/product/submariner-gold")
					@ProductCard("Datejust Classic", "$18,200", "https://images.unsplash.com/photo-1533139502658-0198f920d8e8?w=600&q=85", "/product/datejust-classic")
					@ProductCard("GMT Master II", "$28,500", "https://images.unsplash.com/photo-1523170335258-f5ed11844a49?w=600&q=85", "/product/gmt-master")
				</div>
			</div>
		</section>

		// JavaScript for gallery and quantity
		<script>
			function changeMainImage(thumb, imageKey) {
				const mainImg = document.getElementById('main-product-image');
				const thumbImg = thumb.querySelector('img');
				mainImg.src = thumbImg.src.replace('w=200', 'w=800');

				document.querySelectorAll('.thumb-btn').forEach(t => {
					t.classList.remove('border-gold');
					t.classList.add('border-border');
					t.querySelector('img').classList.add('opacity-70');
				});
				thumb.classList.remove('border-border');
				thumb.classList.add('border-gold');
				thumb.querySelector('img').classList.remove('opacity-70');
			}

			function incrementQty() {
				const input = document.getElementById('product-qty');
				if (parseInt(input.value) < 10) {
					input.value = parseInt(input.value) + 1;
				}
			}

			function decrementQty() {
				const input = document.getElementById('product-qty');
				if (parseInt(input.value) > 1) {
					input.value = parseInt(input.value) - 1;
				}
			}
		</script>
	}
}

// Helper function to format product name from slug
func formatProductName(slug string) string {
	return strings.ReplaceAll(slug, "-", " ")
}

// Get product image based on slug
func getProductImage(slug string, imageType string) string {
	// Default watch images
	images := map[string]string{
		"main":   "https://images.unsplash.com/photo-1587836374828-4dbafa94cf0e?w=800&q=90",
		"thumb1": "https://images.unsplash.com/photo-1587836374828-4dbafa94cf0e?w=200&q=80",
		"thumb2": "https://images.unsplash.com/photo-1509048191080-d2984bad6ae5?w=200&q=80",
		"thumb3": "https://images.unsplash.com/photo-1612817159949-195b6eb9e31a?w=200&q=80",
		"thumb4": "https://images.unsplash.com/photo-1639037687665-8f59c79a71e8?w=200&q=80",
	}

	// Product-specific images
	switch slug {
	case "perpetual-chronograph", "platinum-chronograph":
		images = map[string]string{
			"main":   "https://images.unsplash.com/photo-1587836374828-4dbafa94cf0e?w=800&q=90",
			"thumb1": "https://images.unsplash.com/photo-1587836374828-4dbafa94cf0e?w=200&q=80",
			"thumb2": "https://images.unsplash.com/photo-1509048191080-d2984bad6ae5?w=200&q=80",
			"thumb3": "https://images.unsplash.com/photo-1612817159949-195b6eb9e31a?w=200&q=80",
			"thumb4": "https://images.unsplash.com/photo-1639037687665-8f59c79a71e8?w=200&q=80",
		}
	case "royal-oak-platinum":
		images = map[string]string{
			"main":   "https://images.unsplash.com/photo-1622434641406-a158123450f9?w=800&q=90",
			"thumb1": "https://images.unsplash.com/photo-1622434641406-a158123450f9?w=200&q=80",
			"thumb2": "https://images.unsplash.com/photo-1612817159949-195b6eb9e31a?w=200&q=80",
			"thumb3": "https://images.unsplash.com/photo-1639037687665-8f59c79a71e8?w=200&q=80",
			"thumb4": "https://images.unsplash.com/photo-1509048191080-d2984bad6ae5?w=200&q=80",
		}
	case "submariner-gold":
		images = map[string]string{
			"main":   "https://images.unsplash.com/photo-1548171915-e79a380a2a4b?w=800&q=90",
			"thumb1": "https://images.unsplash.com/photo-1548171915-e79a380a2a4b?w=200&q=80",
			"thumb2": "https://images.unsplash.com/photo-1612817159949-195b6eb9e31a?w=200&q=80",
			"thumb3": "https://images.unsplash.com/photo-1509048191080-d2984bad6ae5?w=200&q=80",
			"thumb4": "https://images.unsplash.com/photo-1639037687665-8f59c79a71e8?w=200&q=80",
		}
	case "datejust-classic":
		images = map[string]string{
			"main":   "https://images.unsplash.com/photo-1533139502658-0198f920d8e8?w=800&q=90",
			"thumb1": "https://images.unsplash.com/photo-1533139502658-0198f920d8e8?w=200&q=80",
			"thumb2": "https://images.unsplash.com/photo-1612817159949-195b6eb9e31a?w=200&q=80",
			"thumb3": "https://images.unsplash.com/photo-1509048191080-d2984bad6ae5?w=200&q=80",
			"thumb4": "https://images.unsplash.com/photo-1639037687665-8f59c79a71e8?w=200&q=80",
		}
	case "midnight-tuxedo":
		images = map[string]string{
			"main":   "https://images.unsplash.com/photo-1593030761757-71fae45fa0e7?w=800&q=90",
			"thumb1": "https://images.unsplash.com/photo-1593030761757-71fae45fa0e7?w=200&q=80",
			"thumb2": "https://images.unsplash.com/photo-1594938298603-c8148c4dae35?w=200&q=80",
			"thumb3": "https://images.unsplash.com/photo-1507679799987-c73779587ccf?w=200&q=80",
			"thumb4": "https://images.unsplash.com/photo-1617127365659-c47fa864d8bc?w=200&q=80",
		}
	case "navy-pinstripe-suit":
		images = map[string]string{
			"main":   "https://images.unsplash.com/photo-1617127365659-c47fa864d8bc?w=800&q=90",
			"thumb1": "https://images.unsplash.com/photo-1617127365659-c47fa864d8bc?w=200&q=80",
			"thumb2": "https://images.unsplash.com/photo-1594938298603-c8148c4dae35?w=200&q=80",
			"thumb3": "https://images.unsplash.com/photo-1593030761757-71fae45fa0e7?w=200&q=80",
			"thumb4": "https://images.unsplash.com/photo-1507679799987-c73779587ccf?w=200&q=80",
		}
	case "gold-signet-ring":
		images = map[string]string{
			"main":   "https://images.unsplash.com/photo-1605100804763-247f67b3557e?w=800&q=90",
			"thumb1": "https://images.unsplash.com/photo-1605100804763-247f67b3557e?w=200&q=80",
			"thumb2": "https://images.unsplash.com/photo-1611591437281-460bfbe1220a?w=200&q=80",
			"thumb3": "https://images.unsplash.com/photo-1599643478518-a784e5dc4c8f?w=200&q=80",
			"thumb4": "https://images.unsplash.com/photo-1603561591411-07134e71a2a9?w=200&q=80",
		}
	case "diamond-cufflinks":
		images = map[string]string{
			"main":   "https://images.unsplash.com/photo-1590548784585-643d2b9f2925?w=800&q=90",
			"thumb1": "https://images.unsplash.com/photo-1590548784585-643d2b9f2925?w=200&q=80",
			"thumb2": "https://images.unsplash.com/photo-1611591437281-460bfbe1220a?w=200&q=80",
			"thumb3": "https://images.unsplash.com/photo-1605100804763-247f67b3557e?w=200&q=80",
			"thumb4": "https://images.unsplash.com/photo-1599643478518-a784e5dc4c8f?w=200&q=80",
		}
	case "crocodile-wallet":
		images = map[string]string{
			"main":   "https://images.unsplash.com/photo-1627123424574-724758594e93?w=800&q=90",
			"thumb1": "https://images.unsplash.com/photo-1627123424574-724758594e93?w=200&q=80",
			"thumb2": "https://images.unsplash.com/photo-1548036328-c9fa89d128fa?w=200&q=80",
			"thumb3": "https://images.unsplash.com/photo-1553062407-98eeb64c6a62?w=200&q=80",
			"thumb4": "https://images.unsplash.com/photo-1606503825008-909a67e63c3d?w=200&q=80",
		}
	case "executive-briefcase":
		images = map[string]string{
			"main":   "https://images.unsplash.com/photo-1548036328-c9fa89d128fa?w=800&q=90",
			"thumb1": "https://images.unsplash.com/photo-1548036328-c9fa89d128fa?w=200&q=80",
			"thumb2": "https://images.unsplash.com/photo-1627123424574-724758594e93?w=200&q=80",
			"thumb3": "https://images.unsplash.com/photo-1553062407-98eeb64c6a62?w=200&q=80",
			"thumb4": "https://images.unsplash.com/photo-1606503825008-909a67e63c3d?w=200&q=80",
		}
	}

	return images[imageType]
}

// Get product price
func getProductPrice(slug string) string {
	prices := map[string]string{
		"perpetual-chronograph": "$24,500",
		"platinum-chronograph":  "$24,500",
		"royal-oak-platinum":    "$48,900",
		"submariner-gold":       "$32,750",
		"datejust-classic":      "$18,200",
		"gmt-master":            "$28,500",
		"midnight-tuxedo":       "$4,850",
		"navy-pinstripe-suit":   "$3,200",
		"charcoal-wool-blazer":  "$1,950",
		"gold-signet-ring":      "$2,850",
		"diamond-cufflinks":     "$4,200",
		"platinum-chain":        "$3,500",
		"onyx-bracelet":         "$1,850",
		"crocodile-wallet":      "$1,450",
		"executive-briefcase":   "$2,800",
		"calfskin-belt":         "$485",
		"italian-silk-tie":      "$295",
	}
	if price, ok := prices[slug]; ok {
		return price
	}
	return "$2,495"
}

// Get product description
func getProductDescription(slug string) string {
	descriptions := map[string]string{
		"perpetual-chronograph": "A masterpiece of horological engineering, this timepiece features a hand-assembled Swiss movement with 72-hour power reserve. The 41mm case is crafted from solid platinum, housing a midnight blue dial with applied 18k gold indices.",
		"platinum-chronograph":  "A masterpiece of horological engineering, this timepiece features a hand-assembled Swiss movement with 72-hour power reserve. The 41mm case is crafted from solid platinum, housing a midnight blue dial with applied 18k gold indices.",
		"royal-oak-platinum":    "The iconic octagonal bezel defines this legendary timepiece. Featuring a Grande Tapisserie dial, the Royal Oak combines sporty elegance with ultra-thin movement technology in a 41mm platinum case.",
		"submariner-gold":       "The ultimate diving watch, crafted in 18k yellow gold with a Cerachrom bezel insert in black ceramic. Water-resistant to 300 meters with a self-winding mechanical movement.",
		"datejust-classic":      "The quintessential classic timepiece featuring the signature fluted bezel, Cyclops lens, and jubilee bracelet. A timeless design that has defined elegance since 1945.",
		"midnight-tuxedo":       "Impeccably tailored from the finest Italian wool, this tuxedo features a satin peak lapel, hand-stitched buttonholes, and a contemporary slim fit. Perfect for black-tie occasions.",
		"navy-pinstripe-suit":   "A sophisticated two-piece suit crafted from Super 150s wool with subtle chalk stripes. Features a half-canvas construction for refined drape and comfort.",
		"gold-signet-ring":      "Hand-engraved solid 18k gold signet ring featuring classic heraldic design. Each piece is individually crafted by our master jewelers using traditional techniques.",
		"diamond-cufflinks":     "Exquisite cufflinks featuring brilliant-cut diamonds set in 18k white gold. The perfect finishing touch for formal occasions.",
		"crocodile-wallet":      "Handcrafted from genuine Niloticus crocodile leather with suede lining. Features multiple card slots, bill compartments, and our signature gold-plated hardware.",
		"executive-briefcase":   "A statement piece crafted from full-grain Italian leather with brass hardware. Features a padded laptop compartment and multiple organizer pockets.",
	}
	if desc, ok := descriptions[slug]; ok {
		return desc
	}
	return "Crafted with exceptional attention to detail, this piece represents the pinnacle of luxury craftsmanship. Each element has been carefully considered to deliver an unparalleled experience."
}

// Product specifications - inline version with Tailwind
templ productSpecsInline(slug string) {
	if strings.Contains(slug, "chronograph") || strings.Contains(slug, "submariner") || strings.Contains(slug, "datejust") || strings.Contains(slug, "royal-oak") || strings.Contains(slug, "gmt") {
		<div class="flex flex-col gap-1">
			<span class="text-xs text-muted uppercase tracking-wider">Movement</span>
			<span class="text-sm text-secondary">Swiss Automatic</span>
		</div>
		<div class="flex flex-col gap-1">
			<span class="text-xs text-muted uppercase tracking-wider">Case Size</span>
			<span class="text-sm text-secondary">41mm</span>
		</div>
		<div class="flex flex-col gap-1">
			<span class="text-xs text-muted uppercase tracking-wider">Case Material</span>
			<span class="text-sm text-secondary">Platinum / 18k Gold</span>
		</div>
		<div class="flex flex-col gap-1">
			<span class="text-xs text-muted uppercase tracking-wider">Water Resistance</span>
			<span class="text-sm text-secondary">100m</span>
		</div>
		<div class="flex flex-col gap-1">
			<span class="text-xs text-muted uppercase tracking-wider">Power Reserve</span>
			<span class="text-sm text-secondary">72 Hours</span>
		</div>
		<div class="flex flex-col gap-1">
			<span class="text-xs text-muted uppercase tracking-wider">Crystal</span>
			<span class="text-sm text-secondary">Sapphire</span>
		</div>
	} else if strings.Contains(slug, "tuxedo") || strings.Contains(slug, "suit") || strings.Contains(slug, "blazer") {
		<div class="flex flex-col gap-1">
			<span class="text-xs text-muted uppercase tracking-wider">Fabric</span>
			<span class="text-sm text-secondary">Super 150s Wool</span>
		</div>
		<div class="flex flex-col gap-1">
			<span class="text-xs text-muted uppercase tracking-wider">Lining</span>
			<span class="text-sm text-secondary">Bemberg Cupro</span>
		</div>
		<div class="flex flex-col gap-1">
			<span class="text-xs text-muted uppercase tracking-wider">Buttons</span>
			<span class="text-sm text-secondary">Horn</span>
		</div>
		<div class="flex flex-col gap-1">
			<span class="text-xs text-muted uppercase tracking-wider">Construction</span>
			<span class="text-sm text-secondary">Full Canvas</span>
		</div>
		<div class="flex flex-col gap-1">
			<span class="text-xs text-muted uppercase tracking-wider">Origin</span>
			<span class="text-sm text-secondary">Italy</span>
		</div>
		<div class="flex flex-col gap-1">
			<span class="text-xs text-muted uppercase tracking-wider">Care</span>
			<span class="text-sm text-secondary">Dry Clean Only</span>
		</div>
	} else if strings.Contains(slug, "ring") || strings.Contains(slug, "cufflinks") || strings.Contains(slug, "bracelet") || strings.Contains(slug, "chain") {
		<div class="flex flex-col gap-1">
			<span class="text-xs text-muted uppercase tracking-wider">Material</span>
			<span class="text-sm text-secondary">18k Gold</span>
		</div>
		<div class="flex flex-col gap-1">
			<span class="text-xs text-muted uppercase tracking-wider">Weight</span>
			<span class="text-sm text-secondary">12.5g</span>
		</div>
		<div class="flex flex-col gap-1">
			<span class="text-xs text-muted uppercase tracking-wider">Finish</span>
			<span class="text-sm text-secondary">Polished</span>
		</div>
		<div class="flex flex-col gap-1">
			<span class="text-xs text-muted uppercase tracking-wider">Hallmark</span>
			<span class="text-sm text-secondary">750</span>
		</div>
	} else {
		<div class="flex flex-col gap-1">
			<span class="text-xs text-muted uppercase tracking-wider">Material</span>
			<span class="text-sm text-secondary">Premium Leather</span>
		</div>
		<div class="flex flex-col gap-1">
			<span class="text-xs text-muted uppercase tracking-wider">Origin</span>
			<span class="text-sm text-secondary">Italy</span>
		</div>
		<div class="flex flex-col gap-1">
			<span class="text-xs text-muted uppercase tracking-wider">Hardware</span>
			<span class="text-sm text-secondary">Gold-Plated</span>
		</div>
		<div class="flex flex-col gap-1">
			<span class="text-xs text-muted uppercase tracking-wider">Lining</span>
			<span class="text-sm text-secondary">Suede</span>
		</div>
	}
}
