package pages

import (
	"platinumapparel/internal/meta"
	"platinumapparel/templates/layouts"
)

templ Home() {
	@layouts.Base(meta.New("Luxury Menswear & Timepieces", "Discover the epitome of luxury menswear, fine jewelry, and prestigious timepieces. Handcrafted excellence for the distinguished gentleman.")) {
		// Hero Section - Cinematic Full Screen
		<section class="hero">
			<div class="hero-background">
				<img src="/static/images/watches/watch_04_watch_case_selection.jpg" alt="Luxury timepiece collection" class="hero-bg-image"/>
			</div>
			<div class="hero-overlay"></div>
			<div class="hero-content" data-animate="fade-up">
				<span class="hero-label">The 2025 Collection</span>
				<h1 class="hero-title">
					<span class="title-line">Timeless</span>
					<span class="title-line accent">Elegance</span>
				</h1>
				<p class="hero-subtitle">Where master craftsmanship meets eternal distinction. Discover pieces that transcend generations.</p>
				<div class="hero-actions">
					<a href="/collections" class="btn-primary">
						<span>Explore Collections</span>
						<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
							<line x1="5" y1="12" x2="19" y2="12"></line>
							<polyline points="12 5 19 12 12 19"></polyline>
						</svg>
					</a>
					<a href="/heritage" class="btn-secondary"><span>Our Heritage</span></a>
				</div>
			</div>
			<div class="hero-scroll">
				<span>Scroll to discover</span>
				<div class="scroll-indicator"></div>
			</div>
		</section>

		// Collections Grid - 3x2 Magazine Style
		<section class="collections-section" id="collections">
			<div class="section-header" data-animate="fade-up">
				<span class="section-label">Curated Excellence</span>
				<h2 class="section-title">Our Collections</h2>
			</div>
			<div class="collections-grid">
				// Watches Card
				<a href="/collections/watches" class="collection-card" data-animate="fade-up">
					<div class="card-image">
						<img src="/static/images/watches/watch_01_black_leather_dial.jpg" alt="Luxury Timepieces" loading="lazy"/>
					</div>
					<div class="card-overlay"></div>
					<div class="card-content">
						<span class="card-label">Horlogerie</span>
						<h3 class="card-title">Fine Timepieces</h3>
						<p class="card-description">Swiss precision meets artistic mastery.</p>
						<span class="card-arrow">
							Discover
							<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
								<line x1="5" y1="12" x2="19" y2="12"></line>
								<polyline points="12 5 19 12 12 19"></polyline>
							</svg>
						</span>
					</div>
				</a>
				// Jewelry Card
				<a href="/collections/jewelry" class="collection-card" data-animate="fade-up" data-delay="100">
					<div class="card-image">
						<img src="/static/images/jewelry/jewelry_01_teardrop_diamond_ring.jpg" alt="Fine Jewelry" loading="lazy"/>
					</div>
					<div class="card-overlay"></div>
					<div class="card-content">
						<span class="card-label">Precious</span>
						<h3 class="card-title">Fine Jewelry</h3>
						<span class="card-arrow">
							Explore
							<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
								<line x1="5" y1="12" x2="19" y2="12"></line>
								<polyline points="12 5 19 12 12 19"></polyline>
							</svg>
						</span>
					</div>
				</a>
				// Suits Card
				<a href="/collections/suits" class="collection-card" data-animate="fade-up" data-delay="200">
					<div class="card-image">
						<img src="/static/images/suits/suit_09_white_suit_bench.jpg" alt="Tailored Suits" loading="lazy"/>
					</div>
					<div class="card-overlay"></div>
					<div class="card-content">
						<span class="card-label">Sartorial</span>
						<h3 class="card-title">Tailored Suits</h3>
						<span class="card-arrow">
							Explore
							<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
								<line x1="5" y1="12" x2="19" y2="12"></line>
								<polyline points="12 5 19 12 12 19"></polyline>
							</svg>
						</span>
					</div>
				</a>
				// Handbags Card
				<a href="/collections/handbags" class="collection-card" data-animate="fade-up" data-delay="300">
					<div class="card-image">
						<img src="/static/images/handbags/handbag_01_minimal_pedestal_bags.jpg" alt="Luxury Handbags" loading="lazy"/>
					</div>
					<div class="card-overlay"></div>
					<div class="card-content">
						<span class="card-label">Artisan</span>
						<h3 class="card-title">Luxury Handbags</h3>
						<span class="card-arrow">
							Explore
							<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
								<line x1="5" y1="12" x2="19" y2="12"></line>
								<polyline points="12 5 19 12 12 19"></polyline>
							</svg>
						</span>
					</div>
				</a>
				// Perfume Card
				<a href="/collections/perfume" class="collection-card" data-animate="fade-up" data-delay="400">
					<div class="card-image">
						<img src="/static/images/perfume/perfume_06_glitter_bottle_peonies.jpg" alt="Fine Fragrances" loading="lazy"/>
					</div>
					<div class="card-overlay"></div>
					<div class="card-content">
						<span class="card-label">Fragrance</span>
						<h3 class="card-title">Fine Fragrances</h3>
						<span class="card-arrow">
							Explore
							<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
								<line x1="5" y1="12" x2="19" y2="12"></line>
								<polyline points="12 5 19 12 12 19"></polyline>
							</svg>
						</span>
					</div>
				</a>
				// Bullion Card
				<a href="/collections/bullion" class="collection-card" data-animate="fade-up" data-delay="500">
					<div class="card-image">
						<img src="/static/images/bullion/bullion_05_mixed_gold_bars.jpg" alt="Precious Metals" loading="lazy"/>
					</div>
					<div class="card-overlay"></div>
					<div class="card-content">
						<span class="card-label">Investment</span>
						<h3 class="card-title">Precious Metals</h3>
						<p class="card-description">Certified gold and silver bullion for the discerning investor.</p>
						<span class="card-arrow">
							Discover
							<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
								<line x1="5" y1="12" x2="19" y2="12"></line>
								<polyline points="12 5 19 12 12 19"></polyline>
							</svg>
						</span>
					</div>
				</a>
			</div>
		</section>

		// Featured Timepieces Section
		<section class="featured-section">
			<div class="section-header" data-animate="fade-up">
				<span class="section-label">Horlogerie</span>
				<h2 class="section-title">Featured Timepieces</h2>
			</div>
			<div class="products-grid">
				@ProductCard("Black Leather Chronograph", "$18,500", "/static/images/watches/watch_01_black_leather_dial.jpg", "/product/black-leather-chronograph")
				@ProductCard("Steel Chronograph", "$24,500", "/static/images/watches/watch_02_steel_chronograph.jpg", "/product/steel-chronograph")
				@ProductCard("Blue Diver Watch", "$32,750", "/static/images/watches/watch_03_blue_diver_watch.jpg", "/product/blue-diver-watch")
				@ProductCard("Grand Complication", "$48,900", "/static/images/watches/watch_05_macro_luxury_dial.jpg", "/product/grand-complication")
			</div>
			<div class="section-cta" data-animate="fade-up">
				<a href="/collections/watches" class="btn-outline"><span>View All Timepieces</span></a>
			</div>
		</section>

		// Luxury Banner - Full Width
		<section class="luxury-banner">
			<div class="luxury-banner-bg">
				<img src="/static/images/suits/suit_04_city_sportscar.jpg" alt="Bespoke tailoring" loading="lazy"/>
			</div>
			<div class="luxury-banner-overlay"></div>
			<div class="luxury-banner-content" data-animate="fade-up">
				<span class="luxury-banner-label">Bespoke Excellence</span>
				<h2 class="luxury-banner-title">The Art of<br/>Tailoring</h2>
				<p class="luxury-banner-text">Every stitch tells a story. Our master tailors bring decades of expertise to create garments that fit not just your body, but your life.</p>
				<a href="/bespoke" class="btn-primary">
					<span>Book Consultation</span>
					<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
						<line x1="5" y1="12" x2="19" y2="12"></line>
						<polyline points="12 5 19 12 12 19"></polyline>
					</svg>
				</a>
			</div>
		</section>

		// Featured Suits & Menswear
		<section class="featured-section">
			<div class="section-header" data-animate="fade-up">
				<span class="section-label">Sartorial Excellence</span>
				<h2 class="section-title">Signature Menswear</h2>
			</div>
			<div class="products-grid">
				@ProductCard("Grey Tweed Formal", "$4,850", "/static/images/suits/suit_01_groom_boutonniere.jpg", "/product/grey-tweed-formal")
				@ProductCard("Riviera Linen Suit", "$3,200", "/static/images/suits/suit_02_beach_cufflinks.jpg", "/product/riviera-linen-suit")
				@ProductCard("Double-Breasted City", "$5,500", "/static/images/suits/suit_04_city_sportscar.jpg", "/product/double-breasted-city")
				@ProductCard("Midnight Dinner Jacket", "$3,800", "/static/images/suits/suit_05_black_jacket_detail.jpg", "/product/midnight-dinner-jacket")
			</div>
			<div class="section-cta" data-animate="fade-up">
				<a href="/collections/suits" class="btn-outline"><span>View All Menswear</span></a>
			</div>
		</section>

		// Craftsmanship Banner
		<section class="craft-banner">
			<div class="craft-content" data-animate="fade-up">
				<span class="craft-label">The Art of Excellence</span>
				<h2 class="craft-title">Uncompromising Craftsmanship</h2>
				<p class="craft-text">Each piece in our collection represents hundreds of hours of meticulous handwork by master artisans who have dedicated their lives to perfecting their craft. From the selection of the finest materials to the final quality inspection, excellence is non-negotiable.</p>
				<a href="/craft" class="btn-primary">
					<span>Discover The Craft</span>
				</a>
			</div>
			<div class="craft-stats">
				<div class="stat" data-animate="fade-up" data-delay="100">
					<span class="stat-number">150+</span>
					<span class="stat-label">Hours per piece</span>
				</div>
				<div class="stat" data-animate="fade-up" data-delay="200">
					<span class="stat-number">47</span>
					<span class="stat-label">Master artisans</span>
				</div>
				<div class="stat" data-animate="fade-up" data-delay="300">
					<span class="stat-number">1892</span>
					<span class="stat-label">Year established</span>
				</div>
			</div>
		</section>

		// Fine Jewelry Section
		<section class="featured-section">
			<div class="section-header" data-animate="fade-up">
				<span class="section-label">Precious Metals</span>
				<h2 class="section-title">Fine Jewelry</h2>
			</div>
			<div class="products-grid">
				@ProductCard("Teardrop Diamond Ring", "$12,500", "/static/images/jewelry/jewelry_01_teardrop_diamond_ring.jpg", "/product/teardrop-diamond-ring")
				@ProductCard("Gold Drop Earrings", "$4,200", "/static/images/jewelry/jewelry_02_gold_earrings_reflection.jpg", "/product/gold-drop-earrings")
				@ProductCard("Rose Gold Bridal Set", "$18,500", "/static/images/jewelry/jewelry_05_rose_gold_bridal_set.jpg", "/product/rose-gold-bridal-set")
				@ProductCard("Sapphire Diamond Ring", "$15,200", "/static/images/jewelry/jewelry_09_sapphire_diamond_gold_ring.jpg", "/product/sapphire-diamond-ring")
			</div>
			<div class="section-cta" data-animate="fade-up">
				<a href="/collections/jewelry" class="btn-outline"><span>View All Jewelry</span></a>
			</div>
		</section>

		// Testimonials
		<section class="testimonials-section">
			<div class="section-header" data-animate="fade-up">
				<span class="section-label">Distinguished Clientele</span>
				<h2 class="section-title">Client Testimonials</h2>
			</div>
			<div class="testimonial-carousel">
				<div class="testimonial-track" id="testimonialTrack">
					@Testimonial("The attention to detail is extraordinary. My bespoke suit from Platinum is the finest I've ever owned. The fit is impeccable.", "James Richardson", "CEO, Sterling Holdings")
					@Testimonial("Their timepieces are not merely watches—they are heirlooms. Exceptional craftsmanship in every way.", "Michael Chen", "Private Collector")
					@Testimonial("From consultation to delivery, the experience was impeccable. This is what true luxury service means.", "David Ashford", "Private Client")
				</div>
				<div class="testimonial-nav">
					<button id="prevTestimonial" class="nav-btn" aria-label="Previous testimonial">
						<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
							<polyline points="15 18 9 12 15 6"></polyline>
						</svg>
					</button>
					<div class="testimonial-dots" id="testimonialDots">
						<button class="dot active" aria-label="Testimonial 1"></button>
						<button class="dot" aria-label="Testimonial 2"></button>
						<button class="dot" aria-label="Testimonial 3"></button>
					</div>
					<button id="nextTestimonial" class="nav-btn" aria-label="Next testimonial">
						<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
							<polyline points="9 18 15 12 9 6"></polyline>
						</svg>
					</button>
				</div>
			</div>
		</section>

		// Luxury Handbags Section
		<section class="featured-section">
			<div class="section-header" data-animate="fade-up">
				<span class="section-label">Designer Bags</span>
				<h2 class="section-title">Luxury Handbags</h2>
			</div>
			<div class="products-grid">
				@ProductCard("Minimal Pedestal Bag", "$2,800", "/static/images/handbags/handbag_01_minimal_pedestal_bags.jpg", "/product/minimal-pedestal-bag")
				@ProductCard("Vintage Gold Handle", "$3,500", "/static/images/handbags/handbag_02_vintage_gold_handle.jpg", "/product/vintage-gold-handle")
				@ProductCard("Orange Designer Bag", "$4,200", "/static/images/handbags/handbag_05_orange_designer_stand.jpg", "/product/orange-designer-bag")
				@ProductCard("Croc Texture Bag", "$5,800", "/static/images/handbags/handbag_06_green_croc_texture.jpg", "/product/croc-texture-bag")
			</div>
			<div class="section-cta" data-animate="fade-up">
				<a href="/collections/handbags" class="btn-outline"><span>View All Handbags</span></a>
			</div>
		</section>

		// Luxury Fragrances Section
		<section class="featured-section">
			<div class="section-header" data-animate="fade-up">
				<span class="section-label">Parfumerie</span>
				<h2 class="section-title">Luxury Fragrances</h2>
			</div>
			<div class="products-grid">
				@ProductCard("Platinum Collection Set", "$850", "/static/images/perfume/perfume_01_fur_surface_collection.jpg", "/product/platinum-collection-set")
				@ProductCard("Amber Night Eau", "$385", "/static/images/perfume/perfume_03_warm_lit_givenchy.jpg", "/product/amber-night-eau")
				@ProductCard("Glitter Peony Parfum", "$320", "/static/images/perfume/perfume_06_glitter_bottle_peonies.jpg", "/product/glitter-peony-parfum")
				@ProductCard("Designer Trio Set", "$650", "/static/images/perfume/perfume_09_designer_bottle_group.jpg", "/product/designer-trio-set")
			</div>
			<div class="section-cta" data-animate="fade-up">
				<a href="/collections/perfume" class="btn-outline"><span>View All Fragrances</span></a>
			</div>
		</section>

		// Precious Metals Section
		<section class="featured-section">
			<div class="section-header" data-animate="fade-up">
				<span class="section-label">Bullion</span>
				<h2 class="section-title">Precious Metals</h2>
			</div>
			<div class="products-grid">
				@ProductCard("Gold Nugget Collection", "$12,500", "/static/images/bullion/bullion_01_gold_nugget_bars.jpg", "/product/gold-nugget-collection")
				@ProductCard("Gold Bar Stack", "$65,000", "/static/images/bullion/bullion_02_gold_bar_stack.jpg", "/product/gold-bar-stack")
				@ProductCard("Mixed Gold Bars", "$25,000", "/static/images/bullion/bullion_05_mixed_gold_bars.jpg", "/product/mixed-gold-bars")
				@ProductCard("Silver Bar Stack", "$1,250", "/static/images/bullion/bullion_09_silver_bars_stack.jpg", "/product/silver-bar-stack")
			</div>
			<div class="section-cta" data-animate="fade-up">
				<a href="/collections/bullion" class="btn-outline"><span>View All Bullion</span></a>
			</div>
		</section>

		// Bespoke CTA
		<section class="bespoke-section">
			<div class="bespoke-background">
				<img src="/static/images/suits/suit_02_beach_cufflinks.jpg" alt="Bespoke experience" loading="lazy"/>
				<div class="bespoke-overlay"></div>
			</div>
			<div class="bespoke-content" data-animate="fade-up">
				<span class="bespoke-label">Personalized Excellence</span>
				<h2 class="bespoke-title">The Bespoke Experience</h2>
				<p class="bespoke-text">Commission a piece as unique as you are. Our master craftsmen will guide you through every detail, from fabric selection to final fitting. Experience luxury tailored to perfection.</p>
				<a href="/bespoke" class="btn-gold">
					<span>Begin Your Journey</span>
				</a>
			</div>
		</section>
	}
}

templ ProductCard(name, price, image, href string) {
	<a href={ templ.SafeURL(href) } class="product-card" data-animate="fade-up">
		<div class="product-image">
			<img src={ image } alt={ name } loading="lazy"/>
			<div class="product-overlay">
				<span class="quick-view">Quick View</span>
			</div>
		</div>
		<div class="product-info">
			<h3 class="product-name">{ name }</h3>
			<span class="product-price">{ price }</span>
		</div>
	</a>
}

templ Testimonial(quote, name, title string) {
	<div class="testimonial">
		<svg class="testimonial-icon" xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="currentColor">
			<path d="M14.017 21v-7.391c0-5.704 3.731-9.57 8.983-10.609l.995 2.151c-2.432.917-3.995 3.638-3.995 5.849h4v10h-9.983zm-14.017 0v-7.391c0-5.704 3.748-9.57 9-10.609l.996 2.151c-2.433.917-3.996 3.638-3.996 5.849h3.983v10h-9.983z"/>
		</svg>
		<blockquote class="testimonial-quote">{ quote }</blockquote>
		<div class="testimonial-author">
			<span class="author-name">{ name }</span>
			<span class="author-title">{ title }</span>
		</div>
	</div>
}
