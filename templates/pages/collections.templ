						@ProductCard("Luxury Lifestyle Tote", "$2,600", "/static/optimized/images/handbags/handbag_10_flatlay_bag_perfume_makeup.jpg", "/product/luxury-lifestyle-tote")
					case "perfume", "fragrances":
						@ProductCard("Platinum Collection Set", "$850", "/static/optimized/images/perfume/perfume_01_fur_surface_collection.jpg", "/product/platinum-collection-set")
						@ProductCard("Classic No.5 Parfum", "$295", "/static/optimized/images/perfume/perfume_02_chanel_no5_minimal.jpg", "/product/classic-no5-parfum")
						@ProductCard("Amber Night Eau", "$385", "/static/optimized/images/perfume/perfume_03_warm_lit_givenchy.jpg", "/product/amber-night-eau")
						@ProductCard("Rose Blush Parfum", "$245", "/static/optimized/images/perfume/perfume_04_pink_bottle_white_surface.jpg", "/product/rose-blush-parfum")
						@ProductCard("Petal Romance Eau", "$195", "/static/optimized/images/perfume/perfume_05_escada_with_petals.jpg", "/product/petal-romance-eau")
						@ProductCard("Glitter Peony Parfum", "$320", "/static/optimized/images/perfume/perfume_06_glitter_bottle_peonies.jpg", "/product/glitter-peony-parfum")
						@ProductCard("Dried Rose Essence", "$275", "/static/optimized/images/perfume/perfume_07_clean_bottle_with_dried_roses.jpg", "/product/dried-rose-essence")
						@ProductCard("Designer Trio Set", "$650", "/static/optimized/images/perfume/perfume_09_designer_bottle_group.jpg", "/product/designer-trio-set")
					case "bullion":
						@ProductCard("Gold Nugget Collection", "$12,500", "/static/optimized/images/bullion/bullion_01_gold_nugget_bars.jpg", "/product/gold-nugget-collection")
						@ProductCard("Gold Bar Stack", "$65,000", "/static/optimized/images/bullion/bullion_02_gold_bar_stack.jpg", "/product/gold-bar-stack")
						@ProductCard("Fine Gold Bar", "$7,800", "/static/optimized/images/bullion/bullion_03_fine_gold_closeup.jpg", "/product/fine-gold-bar")
						@ProductCard("Single Gold Ingot", "$3,950", "/static/optimized/images/bullion/bullion_04_single_gold_ingot.jpg", "/product/single-gold-ingot")
						@ProductCard("Mixed Gold Bars", "$25,000", "/static/optimized/images/bullion/bullion_05_mixed_gold_bars.jpg", "/product/mixed-gold-bars")
						@ProductCard("Investment Gold Bullion", "$42,000", "/static/optimized/images/bullion/bullion_06_gold_bullion_rows.jpg", "/product/investment-gold-bullion")
						@ProductCard("Gold Bar Wood Display", "$8,200", "/static/optimized/images/bullion/bullion_07_single_gold_bar_wood.jpg", "/product/gold-bar-wood-display")
						@ProductCard("Gold Bar Pattern", "$95,000", "/static/optimized/images/bullion/bullion_08_gold_bar_pattern.jpg", "/product/gold-bar-pattern")
						@ProductCard("Silver Bar Stack", "$1,250", "/static/optimized/images/bullion/bullion_09_silver_bars_stack.jpg", "/product/silver-bar-stack")
						@ProductCard("Silver Coin Collector", "$485", "/static/optimized/images/bullion/bullion_10_silver_coin_reflection.jpg", "/product/silver-coin-collector")
					default:
						@ProductCard("Black Leather Chronograph", "$18,500", "/static/optimized/images/watches/watch_01_black_leather_dial.jpg", "/product/black-leather-chronograph")
						@ProductCard("Steel Chronograph", "$24,500", "/static/optimized/images/watches/watch_02_steel_chronograph.jpg", "/product/steel-chronograph")
						@ProductCard("Blue Diver Watch", "$32,750", "/static/optimized/images/watches/watch_03_blue_diver_watch.jpg", "/product/blue-diver-watch")
						@ProductCard("Platinum Presentation Set", "$85,000", "/static/optimized/images/watches/watch_04_watch_case_selection.jpg", "/product/platinum-presentation-set")
						@ProductCard("Grand Complication", "$48,900", "/static/optimized/images/watches/watch_05_macro_luxury_dial.jpg", "/product/grand-complication")
						@ProductCard("Skeleton Mechanical", "$28,500", "/static/optimized/images/watches/watch_07_skeleton_mechanical.jpg", "/product/skeleton-mechanical")
						@ProductCard("Steel Chrono Classic", "$22,200", "/static/optimized/images/watches/watch_09_steel_chrono_studio.jpg", "/product/steel-chrono-classic")
						@ProductCard("Blue Sapphire Mesh", "$15,800", "/static/optimized/images/watches/watch_10_blue_sapphire_mesh.jpg", "/product/blue-sapphire-mesh")
