package pages

import (
	"handler/internal/meta"
	"handler/templates/layouts"
)

templ Concierge() {
	@layouts.Base(meta.New("Private Client Concierge", "Arrange private sourcing, appointments, delivery and lifetime care with the Platinum client team.")) {
		<section class="page-hero concierge-hero">
			<div class="page-hero-content" data-animate="fade-up">
				<span class="page-label">At Your Service</span>
				<h1 class="page-title">Private Client Concierge</h1>
				<p class="page-subtitle">From the first inquiry to decades of care, one dedicated specialist coordinates every detail with discretion.</p>
			</div>
		</section>
		<section class="concierge-intro" id="appointments">
			<div class="concierge-copy" data-animate="fade-up">
				<span class="section-label">Private Appointments</span>
				<h2>A considered, personal experience</h2>
				<p>Reserve an in-person or virtual consultation for collection previews, wardrobe planning, gift selection or a bespoke commission. Appointments are tailored to your priorities and never rushed.</p>
				<div class="concierge-details">
					<div><span>Availability</span><strong>Monday–Saturday</strong></div>
					<div><span>Response time</span><strong>Within one business day</strong></div>
					<div><span>Languages</span><strong>English · French · Italian</strong></div>
				</div>
			</div>
			<form class="concierge-form" id="conciergeForm" data-animate="fade-up">
				<div class="form-field"><label for="client-name">Name</label><input id="client-name" name="name" type="text" autocomplete="name" required/></div>
				<div class="form-field"><label for="client-email">Email</label><input id="client-email" name="email" type="email" autocomplete="email" required/></div>
				<div class="form-field"><label for="client-interest">Area of interest</label><select id="client-interest" name="interest"><option>Private appointment</option><option>Rare timepiece sourcing</option><option>Bespoke tailoring</option><option>Fine jewelry commission</option><option>Care and servicing</option></select></div>
				<div class="form-field"><label for="client-message">How may we assist?</label><textarea id="client-message" name="message" rows="5" required></textarea></div>
				<button type="submit" class="btn-gold"><span>Request an Appointment</span></button>
				<p class="form-note" id="conciergeStatus" aria-live="polite">Your details are treated with strict confidentiality.</p>
			</form>
		</section>
		<section class="concierge-services" id="sourcing">
			<div class="section-header" data-animate="fade-up"><span class="section-label">Beyond the Collection</span><h2 class="section-title">Private Client Services</h2></div>
			<div class="concierge-service-grid">
				<article id="care" data-animate="fade-up"><span>01</span><h3>Lifetime Care</h3><p>Inspection, cleaning, alterations and specialist servicing coordinated through vetted ateliers, with documented service history.</p></article>
				<article data-animate="fade-up" data-delay="100"><span>02</span><h3>Private Sourcing</h3><p>Discreet access to exceptional references from Rolex, Patek Philippe, Cartier, Hermès, Chanel, Brioni and other leading houses.</p></article>
				<article data-animate="fade-up" data-delay="200"><span>03</span><h3>Insured Delivery</h3><p>Complimentary white-glove delivery, fully insured in transit with signature release and flexible appointment windows.</p></article>
			</div>
		</section>
		<section class="concierge-boutique" id="boutique">
			<div class="concierge-boutique-image"><img src="/static/images/watches/watch_04_watch_case_selection.jpg" alt="Private collection presentation" loading="lazy"/></div>
			<div class="concierge-boutique-copy" data-animate="fade-up"><span class="section-label">The Private Salon</span><h2>Designed around your time</h2><p>Our appointment-only salon offers a quiet setting for unhurried discovery. Virtual presentations and secure worldwide delivery are available for clients visiting from afar.</p><a href="#appointments" class="btn-outline"><span>Arrange Your Visit</span></a></div>
		</section>
		<section class="client-policies" id="contact">
			<div><span class="section-label">Client Care</span><h2>Confidence at every stage</h2><p>Every order includes provenance documentation where applicable, condition reporting, signature packaging and insured delivery. Contact the concierge through the request form above for product-specific guidance.</p></div>
			<details id="privacy"><summary>Privacy</summary><p>Information submitted through this website is used only to respond to your request and provide the services you select. It is never sold. You may request access, correction or deletion through the concierge.</p></details>
			<details id="terms"><summary>Terms</summary><p>Availability is subject to confirmation. Product imagery is representative of the listed item; the client team provides condition and provenance documentation before final purchase. Prices may exclude applicable duties and taxes.</p></details>
		</section>
	}
}
