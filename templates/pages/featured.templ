package pages

import (
	"handler/internal/meta"
	"handler/templates/layouts"
)

templ Featured() {
	@layouts.Base(meta.New("Featured Pieces", "Discover our editor's selection of the most exceptional luxury pieces.")) {
		// Hero
		<section class="page-hero featured-hero">
			<div class="page-hero-content" data-animate="fade-up">
				<span class="page-label">Editor's Selection</span>
				<h1 class="page-title">Featured Pieces</h1>
				<p class="page-subtitle">A curated selection of our most exceptional creations, chosen for their extraordinary craftsmanship and timeless appeal.</p>
			</div>
		</section>
		// Highlight Piece
		<section class="featured-highlight-section">
			<div class="highlight-wrapper" data-animate="fade-up">
				<div class="highlight-image image-reveal">
					<img src="/static/images/watches/watch_05_macro_luxury_dial.jpg" alt="Grand Complication" loading="eager" fetchpriority="high" decoding="async"/>
					<span class="highlight-badge">Piece of the Month</span>
				</div>
				<div class="highlight-content">
					<span class="highlight-category">Fine Horology</span>
					<h2 class="highlight-title">The Grand Complication</h2>
					<p class="highlight-description">A masterpiece of horological engineering, featuring a hand-assembled Swiss movement with 72-hour power reserve. The 41mm platinum case houses a midnight blue dial with applied 18k gold indices, completed with a hand-stitched alligator strap.</p>
					<ul class="highlight-features">
						<li>COSC-certified Swiss automatic movement</li>
						<li>72-hour power reserve</li>
						<li>Sapphire crystal with AR coating</li>
						<li>Water resistant to 100 meters</li>
					</ul>
					<div class="highlight-price">$48,900</div>
					<a href="/product/grand-complication" class="btn-gold"><span>View Details</span></a>
				</div>
			</div>
		</section>
		// Featured Timepieces
		<section class="featured-section">
			<div class="section-header" data-animate="fade-up">
				<span class="section-label">Horology</span>
				<h2 class="section-title">Featured Timepieces</h2>
			</div>
			<div class="products-grid">
				@ProductCard("Black Leather Chronograph", "$18,500", "/static/images/watches/watch_01_black_leather_dial.jpg", "/product/black-leather-chronograph")
				@ProductCard("Steel Chronograph", "$24,500", "/static/images/watches/watch_02_steel_chronograph.jpg", "/product/steel-chronograph")
				@ProductCard("Blue Diver Watch", "$32,750", "/static/images/watches/watch_03_blue_diver_watch.jpg", "/product/blue-diver-watch")
				@ProductCard("Skeleton Mechanical", "$28,500", "/static/images/watches/watch_07_skeleton_mechanical.jpg", "/product/skeleton-mechanical")
			</div>
		</section>
		// Luxury Banner
		<section class="luxury-banner">
			<div class="luxury-banner-bg">
				<img src="/static/images/suits/suit_04_city_sportscar.jpg" alt="Sartorial excellence" loading="lazy"/>
			</div>
			<div class="luxury-banner-overlay"></div>
			<div class="luxury-banner-content" data-animate="fade-up">
				<span class="luxury-banner-label">Sartorial Excellence</span>
				<h2 class="luxury-banner-title">Impeccable<br/>Tailoring</h2>
				<p class="luxury-banner-text">Our featured menswear pieces represent the pinnacle of sartorial craftsmanship—hand-selected fabrics, meticulous construction, and timeless design that transcends seasons.</p>
			</div>
		</section>
		// Featured Menswear
		<section class="featured-section">
			<div class="section-header" data-animate="fade-up">
				<span class="section-label">Menswear</span>
				<h2 class="section-title">Featured Tailoring</h2>
			</div>
			<div class="products-grid">
				@ProductCard("Grey Tweed Formal", "$4,850", "/static/images/suits/suit_01_groom_boutonniere.jpg", "/product/grey-tweed-formal")
				@ProductCard("Double-Breasted City", "$5,500", "/static/images/suits/suit_04_city_sportscar.jpg", "/product/double-breasted-city")
				@ProductCard("White Modern Suit", "$3,950", "/static/images/suits/suit_09_white_suit_bench.jpg", "/product/white-modern-suit")
				@ProductCard("Black City Fashion", "$4,100", "/static/images/suits/suit_10_black_city_fashion.jpg", "/product/black-city-fashion")
			</div>
		</section>
		// Featured Jewelry
		<section class="featured-section">
			<div class="section-header" data-animate="fade-up">
				<span class="section-label">Fine Jewelry</span>
				<h2 class="section-title">Featured Pieces</h2>
			</div>
			<div class="products-grid">
				@ProductCard("Teardrop Diamond Ring", "$12,500", "/static/images/jewelry/jewelry_01_teardrop_diamond_ring.jpg", "/product/teardrop-diamond-ring")
				@ProductCard("Rose Gold Bridal Set", "$18,500", "/static/images/jewelry/jewelry_05_rose_gold_bridal_set.jpg", "/product/rose-gold-bridal-set")
				@ProductCard("Monochrome Diamond Ring", "$22,000", "/static/images/jewelry/jewelry_06_monochrome_diamond_ring.jpg", "/product/monochrome-diamond-ring")
				@ProductCard("Diamond Pendant Necklace", "$9,500", "/static/images/jewelry/jewelry_10_diamond_pendant_necklace.jpg", "/product/diamond-pendant-necklace")
			</div>
		</section>
		// Featured Handbags
		<section class="featured-section">
			<div class="section-header" data-animate="fade-up">
				<span class="section-label">Designer Bags</span>
				<h2 class="section-title">Featured Handbags</h2>
			</div>
			<div class="products-grid">
				@ProductCard("Minimal Pedestal Bag", "$2,800", "/static/images/handbags/handbag_01_minimal_pedestal_bags.jpg", "/product/minimal-pedestal-bag")
				@ProductCard("Orange Designer Bag", "$4,200", "/static/images/handbags/handbag_05_orange_designer_stand.jpg", "/product/orange-designer-bag")
				@ProductCard("Croc Texture Bag", "$5,800", "/static/images/handbags/handbag_06_green_croc_texture.jpg", "/product/croc-texture-bag")
				@ProductCard("Metal Trim Structured", "$3,200", "/static/images/handbags/handbag_09_black_white_metal_trim.jpg", "/product/metal-trim-structured")
			</div>
		</section>
		// Featured Fragrances
		<section class="featured-section">
			<div class="section-header" data-animate="fade-up">
				<span class="section-label">Parfumerie</span>
				<h2 class="section-title">Featured Fragrances</h2>
			</div>
			<div class="products-grid">
				@ProductCard("Platinum Collection Set", "$850", "/static/images/perfume/perfume_01_fur_surface_collection.jpg", "/product/platinum-collection-set")
				@ProductCard("Amber Night Eau", "$385", "/static/images/perfume/perfume_03_warm_lit_givenchy.jpg", "/product/amber-night-eau")
				@ProductCard("Glitter Peony Parfum", "$320", "/static/images/perfume/perfume_06_glitter_bottle_peonies.jpg", "/product/glitter-peony-parfum")
				@ProductCard("Dried Rose Essence", "$275", "/static/images/perfume/perfume_07_clean_bottle_with_dried_roses.jpg", "/product/dried-rose-essence")
			</div>
		</section>
		// Featured Bullion
		<section class="featured-section">
			<div class="section-header" data-animate="fade-up">
				<span class="section-label">Investment</span>
				<h2 class="section-title">Featured Bullion</h2>
			</div>
			<div class="products-grid">
				@ProductCard("Gold Bar Stack", "$65,000", "/static/images/bullion/bullion_02_gold_bar_stack.jpg", "/product/gold-bar-stack")
				@ProductCard("Mixed Gold Bars", "$25,000", "/static/images/bullion/bullion_05_mixed_gold_bars.jpg", "/product/mixed-gold-bars")
				@ProductCard("Investment Gold Bullion", "$42,000", "/static/images/bullion/bullion_06_gold_bullion_rows.jpg", "/product/investment-gold-bullion")
				@ProductCard("Gold Bar Pattern", "$95,000", "/static/images/bullion/bullion_08_gold_bar_pattern.jpg", "/product/gold-bar-pattern")
			</div>
		</section>
		// Newsletter
		<section class="featured-newsletter">
			<div class="newsletter-content" data-animate="fade-up">
				<span class="newsletter-label">Stay Informed</span>
				<h2 class="newsletter-title">Be First to Know</h2>
				<p class="newsletter-description">Subscribe to receive exclusive previews of new arrivals, limited editions, and private sale invitations.</p>
				<form class="newsletter-form" action="/newsletter/subscribe" method="POST">
					<input type="email" name="email" placeholder="Enter your email address" required/>
					<button type="submit" class="btn-gold"><span>Subscribe</span></button>
				</form>
			</div>
		</section>
		// CTA
		<section class="bespoke-section">
			<div class="bespoke-background">
				<img src="/static/images/jewelry/jewelry_05_rose_gold_bridal_set.jpg" alt="Visit our boutique" loading="lazy"/>
				<div class="bespoke-overlay"></div>
			</div>
			<div class="bespoke-content" data-animate="fade-up">
				<span class="bespoke-label">Exclusive Experience</span>
				<h2 class="bespoke-title">Private Viewing</h2>
				<p class="bespoke-text">Request a private appointment to view our featured pieces in person with a dedicated style consultant.</p>
				<a href="/appointments" class="btn-gold">
					<span>Book Appointment</span>
				</a>
			</div>
		</section>
	}
}
