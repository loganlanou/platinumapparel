			<div class="page-hero-content" data-animate="fade-up">
				<span class="page-label">Category</span>
				<h1 class="page-title">{ categoryTitle(category) }</h1>
				<p class="page-subtitle">Discover our finest { categoryTitle(category) } collection.</p>
			</div>
		</section>
		<section class="featured-section">
			<div class="products-grid">
				switch category {
					case "watches":
						@pages.ProductCard("Black Leather Chronograph", "$18,500", "/static/optimized/images/watches/watch_01_black_leather_dial.jpg", "/product/black-leather-chronograph")
