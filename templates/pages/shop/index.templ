package shop

import (
	"handler/internal/meta"
	"handler/templates/layouts"
	"handler/templates/pages"
)

templ Index() {
	@layouts.Base(meta.New("Shop", "Browse our complete collection of luxury menswear, timepieces, and fine jewelry.")) {
		// Hero
		<section class="page-hero shop-hero">
			<div class="page-hero-content" data-animate="fade-up">
				<span class="page-label">Shop</span>
				<h1 class="page-title">All Products</h1>
				<p class="page-subtitle">Browse our complete collection of luxury pieces, curated for the distinguished gentleman.</p>
			</div>
		</section>
		// Shop Content
		<section class="shop-content" id="catalog">
			<aside class="shop-filters" data-animate="fade-up">
				<div class="filter-group">
					<h3 class="filter-title">Category</h3>
					<ul class="filter-options">
						<li><a href="/shop" class="filter-link active">All Products</a></li>
						<li><a href="/shop/category/watches" class="filter-link">Timepieces</a></li>
						<li><a href="/shop/category/jewelry" class="filter-link">Fine Jewelry</a></li>
						<li><a href="/shop/category/suits" class="filter-link">Tailored Suits</a></li>
						<li><a href="/shop/category/handbags" class="filter-link">Handbags</a></li>
						<li><a href="/shop/category/perfume" class="filter-link">Fragrances</a></li>
						<li><a href="/shop/category/bullion" class="filter-link">Precious Metals</a></li>
					</ul>
				</div>
				<div class="filter-group">
					<h3 class="filter-title">Price Range</h3>
					<ul class="filter-options">
						<li><a href="/shop?price=under-1000" class="filter-link">Under $1,000</a></li>
						<li><a href="/shop?price=1000-5000" class="filter-link">$1,000 - $5,000</a></li>
						<li><a href="/shop?price=5000-15000" class="filter-link">$5,000 - $15,000</a></li>
						<li><a href="/shop?price=15000-50000" class="filter-link">$15,000 - $50,000</a></li>
						<li><a href="/shop?price=over-50000" class="filter-link">Over $50,000</a></li>
					</ul>
				</div>
			</aside>
			<main class="shop-products">
				<div class="shop-toolbar">
					<label class="catalog-search">
						<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
						<input id="catalogSearch" type="search" placeholder="Search by piece or maison" aria-label="Search the catalog"/>
					</label>
					<span class="product-count" id="productCount">50 curated pieces</span>
					<select class="sort-select" id="catalogSort" aria-label="Sort products">
						<option value="featured">Featured</option>
						<option value="newest">Newest Arrivals</option>
						<option value="price-low">Price: Low to High</option>
						<option value="price-high">Price: High to Low</option>
					</select>
				</div>
				<div class="products-grid">
					// Watches
					@pages.ProductCard("Black Leather Chronograph", "$18,500", "/static/optimized/images/watches/watch_01_black_leather_dial.jpg", "/product/black-leather-chronograph")
					@pages.ProductCard("Steel Chronograph", "$24,500", "/static/optimized/images/watches/watch_02_steel_chronograph.jpg", "/product/steel-chronograph")
					@pages.ProductCard("Blue Diver Watch", "$32,750", "/static/optimized/images/watches/watch_03_blue_diver_watch.jpg", "/product/blue-diver-watch")
					@pages.ProductCard("Grand Complication", "$48,900", "/static/optimized/images/watches/watch_05_macro_luxury_dial.jpg", "/product/grand-complication")
					// Jewelry
					@pages.ProductCard("Teardrop Diamond Ring", "$12,500", "/static/optimized/images/jewelry/jewelry_01_teardrop_diamond_ring.jpg", "/product/teardrop-diamond-ring")
					@pages.ProductCard("Gold Drop Earrings", "$4,200", "/static/optimized/images/jewelry/jewelry_02_gold_earrings_reflection.jpg", "/product/gold-drop-earrings")
					@pages.ProductCard("Rose Gold Bridal Set", "$18,500", "/static/optimized/images/jewelry/jewelry_05_rose_gold_bridal_set.jpg", "/product/rose-gold-bridal-set")
					@pages.ProductCard("Sapphire Diamond Ring", "$15,200", "/static/optimized/images/jewelry/jewelry_09_sapphire_diamond_gold_ring.jpg", "/product/sapphire-diamond-ring")
					// Suits
					@pages.ProductCard("Grey Tweed Formal", "$4,850", "/static/optimized/images/suits/suit_01_groom_boutonniere.jpg", "/product/grey-tweed-formal")
					@pages.ProductCard("Riviera Linen Suit", "$3,200", "/static/optimized/images/suits/suit_02_beach_cufflinks.jpg", "/product/riviera-linen-suit")
					@pages.ProductCard("Double-Breasted City", "$5,500", "/static/optimized/images/suits/suit_04_city_sportscar.jpg", "/product/double-breasted-city")
					@pages.ProductCard("Midnight Dinner Jacket", "$3,800", "/static/optimized/images/suits/suit_05_black_jacket_detail.jpg", "/product/midnight-dinner-jacket")
					// Handbags
					@pages.ProductCard("Minimal Pedestal Bag", "$2,800", "/static/optimized/images/handbags/handbag_01_minimal_pedestal_bags.jpg", "/product/minimal-pedestal-bag")
					@pages.ProductCard("Vintage Gold Handle", "$3,500", "/static/optimized/images/handbags/handbag_02_vintage_gold_handle.jpg", "/product/vintage-gold-handle")
					@pages.ProductCard("Orange Designer Bag", "$4,200", "/static/optimized/images/handbags/handbag_05_orange_designer_stand.jpg", "/product/orange-designer-bag")
					@pages.ProductCard("Croc Texture Bag", "$5,800", "/static/optimized/images/handbags/handbag_06_green_croc_texture.jpg", "/product/croc-texture-bag")
					// Perfume
					@pages.ProductCard("Platinum Collection Set", "$850", "/static/optimized/images/perfume/perfume_01_fur_surface_collection.jpg", "/product/platinum-collection-set")
					@pages.ProductCard("Amber Night Eau", "$385", "/static/optimized/images/perfume/perfume_03_warm_lit_givenchy.jpg", "/product/amber-night-eau")
					@pages.ProductCard("Glitter Peony Parfum", "$320", "/static/optimized/images/perfume/perfume_06_glitter_bottle_peonies.jpg", "/product/glitter-peony-parfum")
					@pages.ProductCard("Designer Trio Set", "$650", "/static/optimized/images/perfume/perfume_09_designer_bottle_group.jpg", "/product/designer-trio-set")
					// Bullion
					@pages.ProductCard("Gold Nugget Collection", "$12,500", "/static/optimized/images/bullion/bullion_01_gold_nugget_bars.jpg", "/product/gold-nugget-collection")
					@pages.ProductCard("Gold Bar Stack", "$65,000", "/static/optimized/images/bullion/bullion_02_gold_bar_stack.jpg", "/product/gold-bar-stack")
					@pages.ProductCard("Mixed Gold Bars", "$25,000", "/static/optimized/images/bullion/bullion_05_mixed_gold_bars.jpg", "/product/mixed-gold-bars")
					@pages.ProductCard("Silver Bar Stack", "$1,250", "/static/optimized/images/bullion/bullion_09_silver_bars_stack.jpg", "/product/silver-bar-stack")
					// Additional catalog pieces
					@pages.ProductCard("Platinum Presentation Set", "$85,000", "/static/optimized/images/watches/watch_04_watch_case_selection.jpg", "/product/platinum-presentation-set")
					@pages.ProductCard("Skeleton Mechanical", "$28,500", "/static/optimized/images/watches/watch_07_skeleton_mechanical.jpg", "/product/skeleton-mechanical")
					@pages.ProductCard("Steel Chrono Classic", "$22,200", "/static/optimized/images/watches/watch_09_steel_chrono_studio.jpg", "/product/steel-chrono-classic")
					@pages.ProductCard("Blue Sapphire Mesh", "$15,800", "/static/optimized/images/watches/watch_10_blue_sapphire_mesh.jpg", "/product/blue-sapphire-mesh")
					@pages.ProductCard("Pearl Diamond Ring", "$6,800", "/static/optimized/images/jewelry/jewelry_03_pearl_diamond_ring.jpg", "/product/pearl-diamond-ring")
					@pages.ProductCard("Monochrome Diamond Ring", "$22,000", "/static/optimized/images/jewelry/jewelry_06_monochrome_diamond_ring.jpg", "/product/monochrome-diamond-ring")
					@pages.ProductCard("Diamond Wave Ring", "$8,900", "/static/optimized/images/jewelry/jewelry_07_ring_on_wavy_dark_surface.jpg", "/product/diamond-wave-ring")
					@pages.ProductCard("Diamond Pendant Necklace", "$9,500", "/static/optimized/images/jewelry/jewelry_10_diamond_pendant_necklace.jpg", "/product/diamond-pendant-necklace")
					@pages.ProductCard("Ivory Tailored Suit", "$4,200", "/static/optimized/images/suits/suit_06_white_womens_suit.jpg", "/product/ivory-tailored-suit")
					@pages.ProductCard("Executive Tie Set", "$495", "/static/optimized/images/suits/suit_08_tie_adjustment_closeup.jpg", "/product/executive-tie-set")
					@pages.ProductCard("White Modern Suit", "$3,950", "/static/optimized/images/suits/suit_09_white_suit_bench.jpg", "/product/white-modern-suit")
					@pages.ProductCard("Black City Fashion", "$4,100", "/static/optimized/images/suits/suit_10_black_city_fashion.jpg", "/product/black-city-fashion")
					@pages.ProductCard("Quilted Pastel Bag", "$2,400", "/static/optimized/images/handbags/handbag_04_blue_mint_quilted.jpg", "/product/quilted-pastel-bag")
					@pages.ProductCard("Boutique Crossbody", "$1,950", "/static/optimized/images/handbags/handbag_08_brown_store_crossbody.jpg", "/product/boutique-crossbody")
					@pages.ProductCard("Metal Trim Structured", "$3,200", "/static/optimized/images/handbags/handbag_09_black_white_metal_trim.jpg", "/product/metal-trim-structured")
					@pages.ProductCard("Luxury Lifestyle Tote", "$2,600", "/static/optimized/images/handbags/handbag_10_flatlay_bag_perfume_makeup.jpg", "/product/luxury-lifestyle-tote")
					@pages.ProductCard("Classic No.5 Parfum", "$295", "/static/optimized/images/perfume/perfume_02_chanel_no5_minimal.jpg", "/product/classic-no5-parfum")
					@pages.ProductCard("Rose Blush Parfum", "$245", "/static/optimized/images/perfume/perfume_04_pink_bottle_white_surface.jpg", "/product/rose-blush-parfum")
					@pages.ProductCard("Petal Romance Eau", "$195", "/static/optimized/images/perfume/perfume_05_escada_with_petals.jpg", "/product/petal-romance-eau")
					@pages.ProductCard("Dried Rose Essence", "$275", "/static/optimized/images/perfume/perfume_07_clean_bottle_with_dried_roses.jpg", "/product/dried-rose-essence")
					@pages.ProductCard("Fine Gold Bar", "$7,800", "/static/optimized/images/bullion/bullion_03_fine_gold_closeup.jpg", "/product/fine-gold-bar")
					@pages.ProductCard("Single Gold Ingot", "$3,950", "/static/optimized/images/bullion/bullion_04_single_gold_ingot.jpg", "/product/single-gold-ingot")
					@pages.ProductCard("Investment Gold Bullion", "$42,000", "/static/optimized/images/bullion/bullion_06_gold_bullion_rows.jpg", "/product/investment-gold-bullion")
					@pages.ProductCard("Gold Bar Wood Display", "$8,200", "/static/optimized/images/bullion/bullion_07_single_gold_bar_wood.jpg", "/product/gold-bar-wood-display")
					@pages.ProductCard("Gold Bar Pattern", "$95,000", "/static/optimized/images/bullion/bullion_08_gold_bar_pattern.jpg", "/product/gold-bar-pattern")
					@pages.ProductCard("Silver Coin Collector", "$485", "/static/optimized/images/bullion/bullion_10_silver_coin_reflection.jpg", "/product/silver-coin-collector")
				</div>
				<div class="catalog-empty" id="catalogEmpty" hidden><h3>No pieces match your search.</h3><p>Try another name or contact our concierge for private sourcing.</p><a href="/concierge#sourcing" class="btn-outline"><span>Private Sourcing</span></a></div>
			</main>
		</section>
	}
}

func categoryTitle(slug string) string {
	switch slug {
	case "watches":
		return "Timepieces"
	case "jewelry":
		return "Fine Jewelry"
	case "suits":
		return "Tailored Suits"
	case "handbags":
		return "Luxury Handbags"
	case "perfume":
		return "Fragrances"
	case "bullion":
		return "Precious Metals"
	default:
		return "Timepieces"
	}
}

templ Category(category string) {
	@layouts.Base(meta.New(categoryTitle(category)+" | Shop", "Browse our "+categoryTitle(category)+" collection.")) {
