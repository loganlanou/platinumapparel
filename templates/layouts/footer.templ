package layouts

import (
	"fmt"
	"handler/internal/meta"
	"time"
)

func currentYear() string {
	return fmt.Sprintf("%d", time.Now().Year())
}

templ Footer() {
	<footer class="site-footer">
		<div class="footer-content">
			<div class="footer-grid">
				// Brand column
				<div class="footer-brand">
					<div class="footer-logo">
						<span class="logo-text">PLATINUM</span>
						<span class="logo-sub">APPAREL</span>
					</div>
					<p class="footer-tagline">An independent destination for exceptional timepieces, fine jewelry, tailoring and objects of enduring value.</p>
					<div class="footer-trust-list" aria-label="Service commitments">
						<span>Authenticated</span>
						<span>Insured</span>
						<span>Discreet</span>
					</div>
				</div>
				// Collections
				<div class="footer-column">
					<h4 class="footer-heading">Collections</h4>
					<ul class="footer-links">
						<li><a href="/collections/watches">Timepieces</a></li>
						<li><a href="/collections/jewelry">Fine Jewelry</a></li>
						<li><a href="/collections/suits">Tailored Suits</a></li>
						<li><a href="/collections/handbags">Handbags</a></li>
						<li><a href="/collections/perfume">Fragrances</a></li>
						<li><a href="/collections/bullion">Precious Metals</a></li>
					</ul>
				</div>
				// Services
				<div class="footer-column">
					<h4 class="footer-heading">Services</h4>
					<ul class="footer-links">
						<li><a href="/bespoke">Bespoke Tailoring</a></li>
						<li><a href="/craft">The Craft</a></li>
						<li><a href="/concierge#appointments">Private Appointments</a></li>
						<li><a href="/concierge#care">Care & Maintenance</a></li>
						<li><a href="/concierge#sourcing">Private Sourcing</a></li>
					</ul>
				</div>
				// Company
				<div class="footer-column">
					<h4 class="footer-heading">Company</h4>
					<ul class="footer-links">
						<li><a href="/heritage">Our Heritage</a></li>
						<li><a href="/concierge#boutique">Boutique</a></li>
						<li><a href="/concierge#contact">Contact</a></li>
					</ul>
				</div>
				// Newsletter
				<div class="footer-newsletter">
					<h4 class="footer-heading">Stay Informed</h4>
					<p class="newsletter-text">Receive exclusive previews and private sale invitations.</p>
					<form id="newsletterForm" class="newsletter-form">
						<input type="email" placeholder="Your email address" required/>
						<button type="submit" class="btn-gold">
							<span>Subscribe</span>
						</button>
					</form>
				</div>
			</div>
			<div class="footer-bottom">
				<p>&copy; { currentYear() } { meta.SiteNameFromCtx(ctx) }. All rights reserved.</p>
				<div class="footer-legal">
					<a href="/concierge#privacy">Privacy</a>
					<a href="/concierge#terms">Terms</a>
				</div>
			</div>
		</div>
	</footer>
}
