package products

import (
	"encoding/json"
	"fmt"
	"strconv"
)

type CartItem struct {
	ID       string
	Name     string
	Price    int64
	Quantity int64
	ImageURL string
}

templ CartDrawer(items []CartItem, total int64) {
	<div class="cart-drawer-content" data-cart-count={ cartQuantity(items) }>
		<div class="cart-header">
			<h2 class="cart-title">Your Cart</h2>
			<button class="cart-close" aria-label="Close cart">
				<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
					<line x1="18" y1="6" x2="6" y2="18"></line>
					<line x1="6" y1="6" x2="18" y2="18"></line>
				</svg>
			</button>
		</div>
		if len(items) == 0 {
			<div class="cart-empty">
				<svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1">
					<path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"></path>
					<line x1="3" y1="6" x2="21" y2="6"></line>
					<path d="M16 10a4 4 0 0 1-8 0"></path>
				</svg>
				<p>Your cart is empty</p>
				<a href="/shop" class="btn-outline">Start Shopping</a>
			</div>
		} else {
			<div class="cart-items">
				for _, item := range items {
					@CartItemRow(item)
				}
			</div>
			<div class="cart-footer">
				<div class="cart-total">
					<span>Total</span>
					<span class="total-amount">{ formatPrice(total) }</span>
				</div>
				<a href="/checkout" class="btn-gold cart-checkout">Proceed to Checkout</a>
			</div>
		}
	</div>
}

templ CartItemRow(item CartItem) {
	<div class="cart-item">
		<img src={ item.ImageURL } alt={ item.Name } class="item-image"/>
		<div class="item-details">
			<h3 class="item-name">{ item.Name }</h3>
			<span class="item-price">{ formatPrice(item.Price) }</span>
			<div class="item-quantity">
				<button
					class="qty-btn"
					hx-post="/cart/update"
					hx-vals={ cartUpdateValues(item.ID, item.Quantity-1) }
					hx-target="#cart-drawer"
				>-</button>
				<span>{ strconv.FormatInt(item.Quantity, 10) }</span>
				<button
					class="qty-btn"
					hx-post="/cart/update"
					hx-vals={ cartUpdateValues(item.ID, item.Quantity+1) }
					hx-target="#cart-drawer"
				>+</button>
			</div>
		</div>
		<button
			class="item-remove"
			hx-post="/cart/remove"
			hx-vals={ cartRemoveValues(item.ID) }
			hx-target="#cart-drawer"
		>
			<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
				<line x1="18" y1="6" x2="6" y2="18"></line>
				<line x1="6" y1="6" x2="18" y2="18"></line>
			</svg>
		</button>
	</div>
}

func formatPrice(cents int64) string {
	return fmt.Sprintf("$%s", commaFormat(cents/100))
}

func commaFormat(value int64) string {
	raw := strconv.FormatInt(value, 10)
	for i := len(raw) - 3; i > 0; i -= 3 {
		raw = raw[:i] + "," + raw[i:]
	}
	return raw
}

func cartUpdateValues(id string, quantity int64) string {
	values, _ := json.Marshal(map[string]string{"product_id": id, "quantity": strconv.FormatInt(quantity, 10)})
	return string(values)
}

func cartRemoveValues(id string) string {
	values, _ := json.Marshal(map[string]string{"product_id": id})
	return string(values)
}

func cartQuantity(items []CartItem) string {
	var count int64
	for _, item := range items {
		count += item.Quantity
	}
	return strconv.FormatInt(count, 10)
}
